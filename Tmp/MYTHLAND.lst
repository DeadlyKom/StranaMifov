   3++7612              ; опрос клавиатуры ROM и Kempston с преобразованием направлений
   4++7612              ; Вызывает ROM #028E. Если E!=#FF, возвращает A=E. Иначе читает порт #1F и повторяет при нуле.
   5++7612              ; Bit4 Kempston немедленно возвращает код действия #27. Для прочих значений ищет точную пару
   6++7612              ; состояние/код в таблице #762F. Проверки отсутствующего порта #FF нет, такое значение имеет бит 4
   7++7612              ; и будет воспринято как действие.
   8++7612              ; In:
   9++7612              ;   порты клавиатуры и Kempston
  10++7612              ; Out:
  11++7612              ;   A — код, #13 вверх-влево, #1B вверх, #23 вверх-вправо, #12 влево, #22 вправо, #11
  12++7612              ;   вниз-влево, #19 вниз, #21 вниз-вправо, #27 действие
  13++7612              ; Corrupt:
  14++7612              ;   HL, DE, BC, AF по ROM и поиску
  15++7612              ; -----------------------------------------
  16++7612 CD 8E 02     ReadMenuInput   CALL Rom.ScanKeyboard                                           ; сканер клавиатуры, E=#FF означает отсутствие распознанной клавиши
  17++7615 7B                           LD A, E
  18++7616 FE FF                        CP #FF
  19++7618 C0                           RET NZ                                                          ; выход, если клавиатурный сканер распознал клавишу
  20++7619 DB 1F                        IN A, (#1F)
  21++761B B7                           OR A
  22++761C 28 F4                        JR Z, ReadMenuInput                                             ; переход, если Kempston не сообщает ни одного направления или кнопки
  23++761E CB 67                        BIT 4, A
  24++7620 28 03                        JR Z, .MapKey                                                   ; переход, если кнопка подтверждения Kempston не нажата
  25++7622 3E 27                        LD A, #27
  26++7624 C9                           RET
  27++7625 21 2E 76     .MapKey         LD HL, Startup.ReadMenuInput.KeyPairs - 1                       ; смещённая база клавиш Kempston, цикл сначала увеличивает HL
  28++7628 23           .FindKeyCode    INC HL
  29++7629 BE                           CP (HL)
  30++762A 23                           INC HL
  31++762B 20 FB                        JR NZ, .FindKeyCode                                             ; переход, если код Kempston ещё не найден в таблице соответствий
  32++762D 7E                           LD A, (HL)
