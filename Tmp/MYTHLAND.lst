   3++698A              ; сохранение или восстановление фона курсора
   4++698A              ; По позиции MenuState.CursorXY сохраняет три экранных байта на каждой из максимум восьми
   5++698A              ; строк в #6C31 или
   6++698A              ; восстанавливает их обратно. Внизу экрана число строк ограничено 192-y.
   7++698A              ; In:
   8++698A              ; C bit 7=0 сохранить фон, C bit 7=1 восстановить, MenuState.CursorXY=x,
   9++698A              ; MenuState.CursorY=y
  10++698A              ; Out:
  11++698A              ;   фон сохранён или экран восстановлен
  12++698A              ; Corrupt:
  13++698A              ;   HL, DE, BC, AF
  14++698A              ; Note:
  15++698A              ;   #6C31..#6C48 или экран, самомодификация CursorBackdrop.BackdropY
  16++698A              ; -----------------------------------------
  17++698A 21 74 6C     CursorBackdrop  LD HL, MenuState.CursorXY
  18++698D 7E                           LD A, (HL)
  19++698E 1F                           RRA
  20++698F 1F                           RRA
