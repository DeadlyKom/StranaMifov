  37++6529 1A           .CompareName    LD A, (DE)
  38++652A BE                           CP (HL)
  39++652B 20 11                        JR NZ, .NextEntry                                               ; переход, если байт имени или типа файла не совпал
  40++652D 13                           INC DE
  41++652E 23                           INC HL
  42++652F 10 F8                        DJNZ .CompareName
