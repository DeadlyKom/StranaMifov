   3++791E              ; дождаться клавиши либо Kempston для меню
   4++791E              ; ROM #028E возвращает E, #FF означает отсутствие клавиши, затем порт #1F, fire возвращает #27,
   5++791E              ; направления ищутся в таблице #793B, при неизвестном ненулевом значении поиск не ограничен
   6++791E              ; In:
   7++791E              ;   клавиатура и Kempston #1F
   8++791E              ; Out:
   9++791E              ;   AF, A код клавиши либо направления, ожидание продолжается до ненулевого ввода
  10++791E              ; Corrupt:
  11++791E              ;   HL, DE, BC, AF, IX/IY собственный код не изменяет, их сохранение ROM #028E отдельно не
  12++791E              ;   проверено
  13++791E              ; -----------------------------------------
  14++791E CD 8E 02     WaitMenuInput   CALL Rom.KeyScan                                                ; сканирование матрицы клавиатуры и возврат E=#FF при отсутствии клавиши
  15++7921 7B                           LD A, E
  16++7922 FE FF                        CP #FF
  17++7924 C0                           RET NZ                                                          ; выход, если ROM вернул нажатую клавишу
  18++7925 DB 1F                        IN A, (#1F)
  19++7927 B7                           OR A
  20++7928 28 F4                        JR Z, WaitMenuInput                                             ; переход, если Kempston не дал команды
  21++792A CB 67                        BIT 4, A
  22++792C 28 03                        JR Z, .SelectKeyTable                                           ; переход, если кнопка огня Kempston не нажата
  23++792E 3E 27                        LD A, #27
  24++7930 C9                           RET
  25++7931 21 3A 79     .SelectKeyTable LD HL, Engine.WaitMenuInput.KempstonPairs - 1                   ; восемь пар Kempston-код и команда меню
  26++7934 23           .FindKey        INC HL
  27++7935 BE                           CP (HL)
  28++7936 23                           INC HL
  29++7937 20 FB                        JR NZ, .FindKey                                                 ; переход, если код ещё не совпал с записью таблицы джойстика
  30++7939 7E                           LD A, (HL)
  31++793A C9                           RET
  32++793B
