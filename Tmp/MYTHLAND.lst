   3++6161              ; обработать маскируемое прерывание IM 2
   4++6161              ; сохраняет основные и альтернативные регистры, IX, IY, текущий банк и изменяемые адреса вызова в
   5++6161              ; #703B и #708D, увеличивает 16-битный счётчик #6561, при бите 5 #6566 обновляет анимацию символов
