   3++7347              ; вывод страницы до пятнадцати имён сохранений
   4++7347              ; Число активных пунктов #7CA6 начинает с 5 для служебных кнопок. От индекса #7385 выводит не
   5++7347              ; более 15 имён, заканчивая при превышении общего числа #7384. #732A находит каждое сохранение,
   6++7347              ; восемь байтов имени печатает в строках от 4, столбце 4. Для каждого имени увеличивает число
   7++7347              ; пунктов меню.
   8++7347              ; In:
   9++7347              ;   #7384 — число сохранений, #7385 — первый индекс страницы
  10++7347              ; Out:
  11++7347              ;   #7CA6=5+число показанных имён
  12++7347              ; Corrupt:
  13++7347              ;   HL, DE, BC, AF, IX
  14++7347              ; Note:
  15++7347              ;   экран, #7CA6
