  21+ B200 CD 34 6D     Entry           CALL Engine.StopView                                            ; выключить обработку объектов в прерывании
  22+ B203 CD 3F 6D                     CALL Engine.ResetViewFlags                                      ; сбросить младшие шесть флагов 48 записей объектов
  23+ B206 3E 03                        LD A, #03
