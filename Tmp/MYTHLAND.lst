 434+ B5E9              ; -----------------------------------------
 435+ B5E9              ; поиск N-го собственного замка в таблице из 35-байтовых записей
 436+ B5E9              ; От IX=#BFE0 прибавляет 35 до указателя имени очередной записи. Пропускает запись при
 437+ B5E9              ; установленном бит 0 по IX-3 либо ненулевом владельце по IX+16. DJNZ считает только подходящие
 438+ B5E9              ; записи. Число A должно соответствовать существующему замку, явной конечной границы у этого
 439+ B5E9              ; поиска нет.
 440+ B5E9              ; In:
 441+ B5E9              ;   A — порядковый номер своего замка с 1
 442+ B5E9              ; Out:
 443+ B5E9              ;   IX — имя найденного замка, DE, BC, AF сохранены
 444+ B5E9              ; Corrupt:
 445+ B5E9              ;   IX. HL, DE, BC, AF, HL', DE', BC', AF', IY сохранены, DE, BC и AF явно восстанавливаются со
 446+ B5E9              ;   стека
 447+ B5E9              ; Note:
 448+ B5E9              ;   IX
 449+ B5E9              ; -----------------------------------------
 450+ B5E9 D5           FindOwnCastle   PUSH DE
 451+ B5EA C5                           PUSH BC
 452+ B5EB F5                           PUSH AF
 453+ B5EC 47                           LD B, A
 454+ B5ED DD 21 E0 BF                  LD IX, Runtime.Castles + FCastle.Name - FCastle                 ; база перед именем первой записи замка для цикла с первым ADD на FCastle
 455+ B5F1 11 23 00                     LD DE, #0023
 456+ B5F4
 457+ B5F4                              ; счётчик уменьшается только на действующих собственных замках, чужие и
 458+ B5F4                              ; выключенные записи пропускаются
 459+ B5F4 DD 19        .NextCastle     ADD IX, DE
 460+ B5F6 DD CB FD 46                  BIT 0, (IX + FCastle.Flags - FCastle.Name)                      ; -#03, бит 0 выключает запись, значения остальных битов отдельно не установлены
 461+ B5FA 20 F8                        JR NZ, .NextCastle                                              ; переход, если запись замка выключена из общего поиска
 462+ B5FC DD 7E 10                     LD A, (IX + FCastle.Owner - FCastle.Name)                       ; +#10, 0 собственный замок, 1..15 правитель FRuler, #FF особое отсутствие правителя/банды
 463+ B5FF B7                           OR A
 464+ B600 20 F2                        JR NZ, .NextCastle                                              ; переход, если замок принадлежит другому правителю
 465+ B602 10 F0                        DJNZ .NextCastle
 466+ B604 F1                           POP AF
 467+ B605 C1                           POP BC
 468+ B606 D1                           POP DE
 469+ B607 C9                           RET
