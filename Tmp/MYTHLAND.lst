   3+ 7F80                              module Presentation
   4+ 7F80                              org #C000
   5+ C000
   6+ C000              screen          INCBIN "Assets/Gfx/PRES/PRES_screen.scr"                        ; графический ресурс, исходное смещение #0000
   7+ DB00              font            INCBIN "Assets/Gfx/PRES/PRES_font.bin"                          ; графический ресурс, исходное смещение #1B00
