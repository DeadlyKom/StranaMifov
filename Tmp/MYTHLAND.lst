   2++619D              ; -----------------------------------------
   3++619D              ; перехватчик RST #10 внутри защитного преобразования
   4++619D              ; Три POP HL снимают промежуточные адреса пути канала вывода, два DEC SP возвращают позицию к
   5++619D              ; исходному адресу RST. Дополнительные XOR H и L смешивают снятый адрес с A. EXX возвращает
   6++619D              ; рабочие регистры дешифратора, RET возвращает к #618E. Здесь стек является частью алгоритма
   7++619D              ; защиты, обычный подпрограммный контракт неприменим.
   8++619D              ; In:
   9++619D              ;   стек и альтернативные регистры после пути вывода ПЗУ
  10++619D              ; Out:
  11++619D              ;   A содержит дополнительное XOR-преобразование, возврат к #618E
  12++619D              ; Corrupt:
  13++619D              ;   HL, AF, HL', DE', BC'
  14++619D              ; -----------------------------------------
  15++619D E1           PrintHook       POP HL
  16++619E E1                           POP HL
  17++619F E1                           POP HL
