  30++6E1A 21 18 79                     LD HL, Loader.Menu.EraseTail                                    ; первый байт хвостовой области, стираемой перед переносом KB.co
  31++6E1D 11 19 79                     LD DE, Loader.Menu.EraseTail + 1                                ; следующий байт стираемого хвоста для перекрывающегося LDIR
