 862+ B7D3 78                           LD A, B
 863+ B7D4 E6 E0                        AND #E0
 864+ B7D6 6F                           LD L, A
 865+ B7D7 78                           LD A, B
 866+ B7D8 0F                           RRCA
 867+ B7D9 0F                           RRCA
 868+ B7DA E6 07                        AND #07
 869+ B7DC CB 24                        SLA H
 870+ B7DE CB 24                        SLA H
 871+ B7E0 CB 24                        SLA H
 872+ B7E2 B4                           OR H
 873+ B7E3 67                           LD H, A
 874+ B7E4 79                           LD A, C
 875+ B7E5 E6 07                        AND #07
 876+ B7E7 CB 39                        SRL C
 877+ B7E9 CB 39                        SRL C
 878+ B7EB CB 39                        SRL C
 879+ B7ED 06 00                        LD B, #00
 880+ B7EF 09                           ADD HL, BC
 881+ B7F0 3C                           INC A
 882+ B7F1 47                           LD B, A
 883+ B7F2 AF                           XOR A
 884+ B7F3 37                           SCF
