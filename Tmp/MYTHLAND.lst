  43++64E7 11 38 7C                     LD DE, Loader.Menu.HeadSector
  44++64EA 21 9E 66                     LD HL, Loader.Menu.SelectDrive.HeadFile                         ; девятибайтное имя head.co для настройки деградации
  45++64ED 01 06 01                     LD BC, #0106
  46++64F0 CD DE 65                     CALL AccessFile                                                 ; операция с файлом по имени и смещению в секторах
  47++64F3
  48++64F3                              ; самомодифицируемый флаг показывает, нужно ли после дисковых операций
  49++64F3                              ; возобновить музыку
  50++64F3 3E 00        .RestoreMusic   LD A, #00
