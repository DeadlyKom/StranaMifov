   3++7416              ; маскированная запись одного байта курсора
   4++7416              ; Если H<#58, записывает (экран AND маска IY) OR рисунок IX. При H>=#58 запись пропускается. В
   5++7416              ; любом случае увеличивает HL, IX, IY, сохраняя продвижение источников даже за нижней границей
   6++7416              ; пиксельной памяти.
   7++7416              ; In:
   8++7416              ;   HL — экран, IX — рисунок, IY — маска
   9++7416              ; Out:
  10++7416              ;   HL, IX, IY увеличены на 1
  11++7416              ; Corrupt:
  12++7416              ;   HL, AF, IX, IY
  13++7416              ; Note:
  14++7416              ;   байт экрана при H<#58
  15++7416              ; -----------------------------------------
  16++7416 7C           DrawCursorByte  LD A, H
  17++7417 FE 58                        CP #58
  18++7419 30 08                        JR NC, .NextByte                                                ; переход, если адрес уже вышел из пиксельной области экрана
  19++741B 7E                           LD A, (HL)
  20++741C FD A6 00                     AND (IY)
  21++741F DD B6 00                     OR (IX)
  22++7422 77                           LD (HL), A
  23++7423 23           .NextByte       INC HL
  24++7424 DD 23                        INC IX
  25++7426 FD 23                        INC IY
  26++7428 C9                           RET
