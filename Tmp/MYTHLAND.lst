   1++615E
   2++615E              ; -----------------------------------------
   3++615E              ; передать управление начальной настройке игры
   4++615E              ; передаёт управление инициализации 631C
   5++615E              ; In:
   6++615E              ;   тело BL3 расшифровано, в 615E находится JP631C
   7++615E              ; Out:
   8++615E              ;   управление передано инициализации 631C, собственная инструкция JP сохраняет все регистры
   9++615E              ;   общего назначения, SP и флаги
  10++615E              ; Corrupt:
  11++615E              ;   собственных изменений общих регистров и памяти нет, R увеличивается при выборке JP
  12++615E              ; -----------------------------------------
  13++615E C3 1C 63     Entry           JP Init
