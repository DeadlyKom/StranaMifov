  25++617E 3E 59                        LD A, #59
  26++6180 ED 4F                        LD R, A
  27++6182 21 A8 61                     LD HL, MainMenu
  28++6185 11 7D 15                     LD DE, #157D
  29++6188 ED 5F                        LD A, R
  30++618A AE                           XOR (HL)
  31++618B AC                           XOR H
  32++618C AD                           XOR L
  33++618D D7                           RST #10
  34++618E
  35++618E AA AB 77 23                  DB #AA, #AB, #77, #23, #1B, #7B, #B2, #20
  35++6192 1B 7B B2 20
  36++6196 F1 21                        DB #F1, #21
  37++6198 26 5D        .SavedChannel   DW #5D26                                                        ; сохранённый канал вывода BASIC, операнд восстанавливающей LD HL
