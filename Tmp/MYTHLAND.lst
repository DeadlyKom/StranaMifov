  28++F8D2 E5                           PUSH HL
  29++F8D3 FD 7E 00                     LD A, (IY + FBattleUnit.UnitID)                                 ; +#00, ID типа, 0 завершает плотный список
  30++F8D6 CD DB 80                     CALL Engine.UnitSpriteAddr                                      ; выбрать банк и начало четырёхкадрового графического ресурса
  31++F8D9 DD 71 08                     LD (IX + FScreenObject20.Frame1Bank), C
  32++F8DC DD 75 09                     LD (IX + FScreenObject20.Frame1Address.Low), L
  33++F8DF DD 74 0A                     LD (IX + FScreenObject20.Frame1Address.High), H
  34++F8E2 DD 7E 00                     LD A, (IX + FScreenObject20.Flags)
  35++F8E5 E6 80                        AND #80
  36++F8E7              .ObjectFlags    EQU $+1                                                         ; операнд A флагов неподвижного экранного объекта отряда
  37++F8E7 F6 43                        OR #43
  38++F8E9 DD 77 00                     LD (IX + FScreenObject20.Flags), A
  39++F8EC FD E5                        PUSH IY
  40++F8EE E1                           POP HL
  41++F8EF 23                           INC HL
  42++F8F0 23                           INC HL
  43++F8F1 CD AE 6D                     CALL Engine.StackFloat5                                         ; передать пятибайтное число по HL на стек калькулятора
  44++F8F4 FD 7E 02                     LD A, (IY + FBattleUnit.Quantity)                               ; +#02, пятибайтовое число ROM, сохраняет дробные потери
  45++F8F7 B7                           OR A
  46++F8F8 28 05                        JR Z, .StoreCount                                               ; переход, если численность хранится в короткой целочисленной форме
  47++F8FA EF                           RST #28                                                         ; передача вычисления стековому калькулятору ПЗУ, токены следуют ниже
  48++F8FB 27                           DB #27                                                          ; int, округление вниз, F8FB
  49++F8FC A1                           DB #A1                                                          ; stk-one, константа 1, F8FC
  50++F8FD 0F                           DB #0F                                                          ; addition, сложение, F8FD
  51++F8FE 38                           DB #38                                                          ; end-calc, возврат в Z80, F8FE
  52++F8FF CD 76 6D     .StoreCount     CALL Engine.PopBC                                               ; извлечь результат калькулятора ROM в BC
  53++F902 E1                           POP HL
