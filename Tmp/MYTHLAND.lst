 698+ E58F 23                           INC HL
 699+ E590 4E                           LD C, (HL)
 700+ E591 CD A2 E5                     CALL PlotStar                                                   ; изменить один звёздный пиксель только в области свободного фона
 701+ E594 0D                           DEC C
 702+ E595 71                           LD (HL), C
 703+ E596 CD A2 E5                     CALL PlotStar                                                   ; изменить один звёздный пиксель только в области свободного фона
 704+ E599 23                           INC HL
 705+ E59A 15                           DEC D
 706+ E59B 20 F1                        JR NZ, .MoveStarLoop                                            ; переход, если остаются звёзды для сдвига на один пиксель
 707+ E59D F1                           POP AF
 708+ E59E C1                           POP BC
 709+ E59F D1                           POP DE
 710+ E5A0 E1                           POP HL
 711+ E5A1 C9                           RET
