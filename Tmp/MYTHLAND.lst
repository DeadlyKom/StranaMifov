  12++78D0              ;   банк 0
  13++78D0              ; Out:
  14++78D0              ;   записано 2..5 отрядов, IY после них, IX сохранён
  15++78D0              ; Corrupt:
  16++78D0              ;   HL, DE, BC, AF, IY
  17++78D0              ; Note:
