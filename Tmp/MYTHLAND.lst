   3++6657              ; получение одной десятичной цифры повторным вычитанием
   4++6657              ; Вычитает C из A и увеличивает B до займа. Восстанавливает остаток, пишет B+ASCII 0 по HL и
   5++6657              ; увеличивает HL.
   6++6657              ; In:
   7++6657              ;   A — делимое, C — делитель, B=0, HL — приёмник
   8++6657              ; Out:
   9++6657              ;   A — остаток, HL увеличен на 1
  10++6657              ; Corrupt:
  11++6657              ;   HL, BC, AF
  12++6657              ; Note:
  13++6657              ;   байт по исходному HL
  14++6657              ; -----------------------------------------
  15++6657 91           WriteDigit      SUB C
  16++6658 38 03                        JR C, .StoreDigit                                               ; переход, если остаток меньше текущего десятичного разряда
  17++665A 04                           INC B
  18++665B 18 FA                        JR WriteDigit
  19++665D 81           .StoreDigit     ADD A, C
  20++665E 4F                           LD C, A
  21++665F 78                           LD A, B
  22++6660 C6 30                        ADD A, #30
  23++6662 77                           LD (HL), A
  24++6663 23                           INC HL
  25++6664 79                           LD A, C
  26++6665 C9                           RET
