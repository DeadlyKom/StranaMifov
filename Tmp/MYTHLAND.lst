   2++6938              ; -----------------------------------------
   3++6938              ; подсветка области меню под курсором
   4++6938              ; Проходит тройки (x, y, длина) по указателю MenuState.Areas до #FF. Проверяет B как
   5++6938              ; строку, C как столбец.
   6++6938              ; Бит 7 первого байта хранит текущую подсветку. При входе или выходе меняет бит и переставляет
   7++6938              ; INK/PAPER в полосе атрибутов через SwapAttrStrip.
   8++6938              ; In:
   9++6938              ;   B — строка курсора, C — столбец курсора, MenuState.Areas — таблица областей
  10++6938              ; Out:
  11++6938              ;   активная область отмечена битом 7
  12++6938              ; Corrupt:
  13++6938              ;   HL, DE, AF, IX, BC сохраняется вспомогательным изменением атрибутов
  14++6938              ; Note:
  15++6938              ;   таблица областей, атрибуты экрана
  16++6938              ; -----------------------------------------
  17++6938 DD 2A 7A 6C  HighlightAreas  LD IX, (MenuState.Areas)
  18++693C
  19++693C                              ; тройка области задаёт столбец, строку и длину, бит 7 первого байта хранит
  20++693C                              ; состояние подсветки
  21++693C DD 7E 00     .AreaLoop       LD A, (IX + FMenuArea.XAndActive)
  22++693F FE FF                        CP #FF
  23++6941 C8                           RET Z                                                           ; выход, если достигнут завершающий байт таблицы областей
  24++6942 FA 64 69                     JP M, .CheckActive                                              ; переход, если область уже подсвечена и нужно проверить выход курсора
  25++6945 5F                           LD E, A
  26++6946 78                           LD A, B
  27++6947 DD BE 01                     CP (IX + FMenuArea.Y)
  28++694A 20 37                        JR NZ, .NextArea                                                ; переход, если курсор находится в другой строке
  29++694C 79                           LD A, C
  30++694D 93                           SUB E
  31++694E 38 33                        JR C, .NextArea                                                 ; переход, если курсор расположен левее области
  32++6950 DD BE 02                     CP (IX + FMenuArea.Width)
  33++6953 30 2E                        JR NC, .NextArea                                                ; переход, если курсор расположен справа от области
  34++6955 DD 56 01                     LD D, (IX + FMenuArea.Y)
  35++6958 DD 7E 02                     LD A, (IX + FMenuArea.Width)
  36++695B DD CB 00 FE                  SET 7, (IX + FMenuArea.XAndActive)
  37++695F CD 43 6E                     CALL SwapAttrStrip                                              ; обмен цветов INK и PAPER в полосе атрибутов
  38++6962 18 1F                        JR .NextArea
  39++6964 E6 7F        .CheckActive    AND #7F
  40++6966 5F                           LD E, A
  41++6967 78                           LD A, B
  42++6968 DD BE 01                     CP (IX + FMenuArea.Y)
  43++696B 20 09                        JR NZ, .Unhighlight                                             ; переход, если курсор покинул строку подсвеченной области
  44++696D 79                           LD A, C
  45++696E 93                           SUB E
  46++696F 38 05                        JR C, .Unhighlight                                              ; переход, если курсор вышел за левую границу подсвеченной области
  47++6971 DD BE 02                     CP (IX + FMenuArea.Width)
  48++6974 38 0D                        JR C, .NextArea                                                 ; переход, если курсор всё ещё находится внутри подсвеченной области
  49++6976
  50++6976                              ; при выходе курсора из области инверсия цветов выполняется повторно и снимает
  51++6976                              ; подсветку
  52++6976 DD CB 00 BE  .Unhighlight    RES 7, (IX + FMenuArea.XAndActive)
  53++697A DD 56 01                     LD D, (IX + FMenuArea.Y)
  54++697D DD 7E 02                     LD A, (IX + FMenuArea.Width)
  55++6980 CD 43 6E                     CALL SwapAttrStrip                                              ; обмен цветов INK и PAPER в полосе атрибутов
