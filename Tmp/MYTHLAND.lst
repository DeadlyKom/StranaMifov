   9++7674              ;   A — положительное число пиксельных сдвигов
  10++7674              ; Out:
  11++7674              ;   A=0, B=0, образцы повёрнуты
  12++7674              ; Corrupt:
  13++7674              ;   HL, DE, BC, AF
