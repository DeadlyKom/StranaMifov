   2++732A              ; -----------------------------------------
   3++732A              ; поиск N-й неудалённой записи типа M в буфере каталога
   4++732A              ; Начинает перед каталогом с IX=#BFF0, добавляет 16 байтов на запись. Сравнивает тип+8 с ASCII M,
   5++732A              ; пропускает удалённые записи с первым байтом 1. Счётчик B уменьшается только для подходящих
   6++732A              ; записей. Проверки нулевого конца каталога здесь нет, поэтому A должен не превышать уже
   7++732A              ; подсчитанное число сохранений.
   8++732A              ; In:
   9++732A              ;   A — порядковый номер сохранения с 1, текущий банк содержит каталог по #C000
  10++732A              ; Out:
  11++732A              ;   IX —16-байтовая запись, BC сохранён
  12++732A              ; Corrupt:
  13++732A              ;   DE, AF, IX
  14++732A              ; -----------------------------------------
  15++732A C5           FindSaveRecord  PUSH BC
  16++732B 47                           LD B, A
  17++732C DD 21 F0 BF                  LD IX, StartupTables.Directory - FTrdosEntry                    ; позиция перед первой записью каталога, цикл сначала добавляет16байтов
  18++7330 11 10 00                     LD DE, #0010
  19++7333 DD 19        .RecordLoop     ADD IX, DE
  20++7335 DD 7E 08                     LD A, (IX + FTrdosEntry.Type)
  21++7338 FE 4D                        CP #4D
  22++733A 20 F7                        JR NZ, .RecordLoop                                              ; переход, если запись не имеет сигнатуры сохранения M
  23++733C DD 7E 00                     LD A, (IX + FTrdosEntry.Name)
  24++733F FE 01                        CP #01
  25++7341 28 F0                        JR Z, .RecordLoop                                               ; переход, если запись каталога помечена как удалённая
  26++7343 10 EE                        DJNZ .RecordLoop
  27++7345 C1                           POP BC
  28++7346 C9                           RET
  29++7347
