  28++7682 CB 1E                        RR (HL)
  29++7684 23                           INC HL
  30++7685 30 04                        JR NC, .NextRow                                                 ; переход, если правый край курсора не требует переноса пикселя в левый
  31++7687 EB                           EX DE, HL
  32++7688 CB FE                        SET 7, (HL)
  33++768A EB                           EX DE, HL
