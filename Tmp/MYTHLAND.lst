  44++6533 E1                           POP HL
  45++6534 11 DD 5C                     LD DE, TrDos.Descriptor
  46++6537 01 10 00                     LD BC, #0010
  47++653A ED B0                        LDIR
  48++653C              .Found          EQU $                                                           ; SCF нормального завершения FindFile, используется перехватом возврата TR-DOS
  49++653C 37                           SCF
  50++653D C9                           RET
  51++653E 11 10 00     .NextEntry      LD DE, #0010
  52++6541 DD 19                        ADD IX, DE
  53++6543 0D                           DEC C
