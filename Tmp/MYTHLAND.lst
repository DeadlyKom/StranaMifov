   2++AC78              ; -----------------------------------------
   3++AC78              ; восстановить население опустевших объектов по ближайшему населённому объекту
   4++AC78              ; одинразна 4 вызова, группы #6B19/#6B29/#6B39/#6B49, активные записи 6 байт с количеством+4/+5
   5++AC78              ; равным 0, #7A4E определяет континент по адресу записи, #7F5F ищет ближайшую другую запись тойже
   6++AC78              ; группы, если у неё количество ненулевое, копируется ID типа+3, количество инициализируется полем
   7++AC78              ; 32/33 описателя типа, случайного генератора здесь нет
   8++AC78              ; In:
   9++AC78              ;   банк 0 уже выбран, #6A2D континент, группы #6B19/#6B29/#6B39/#6B49, счётчик #AD30
  10++AC78              ; Out:
  11++AC78              ;   счётчик уменьшен, каждый 4 вызов активные пустые записи получают ID ближайшего населённого
  12++AC78              ;   объекта и количество из поля 32/33SOLDIERS, при реальном заполнении восстановлен банк 0
  13++AC78              ; Corrupt:
  14++AC78              ;   HL, DE, BC, AF, IX, IY, #AD30 и содержимое объектов, альтернативные регистры собственным
  15++AC78              ;   кодом не используются
  16++AC78              ; -----------------------------------------
