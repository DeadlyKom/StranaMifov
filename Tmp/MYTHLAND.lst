  25++6519 DD 7E 00     .DirectoryEntry LD A, (IX + FTrdosEntry.Name)
  26++651C B7                           OR A
  27++651D C8                           RET Z                                                           ; выход, если достигнут конец каталога
  28++651E 3D                           DEC A
  29++651F 28 1D                        JR Z, .NextEntry                                                ; переход, если запись каталога помечена удалённой
  30++6521 DD E5                        PUSH IX
  31++6523 D1                           POP DE
  32++6524 21 DD 5C                     LD HL, TrDos.Descriptor
  33++6527 06 09                        LD B, #09
  34++6529
  35++6529                              ; сравниваются восемь байтов имени и байт типа, найденный дескриптор копируется
