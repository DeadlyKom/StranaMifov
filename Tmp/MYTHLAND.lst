   1++6149
   2++6149              ; -----------------------------------------
   3++6149              ; расшифровать начальный модуль перед передачей управления
   4++6149              ; после внешнего дешифрования из KB отключает прерывания и задаёт R=50, XOR с показаниями R
   5++6149              ; обрабатывает 7125 байтов 615E..7D32, первый ключ 54, шаг 9 по модулю 128, последний байт файла
   6++6149              ; 7D33 не меняется этим проходом
   7++6149              ; In:
   8++6149              ;   BL3 после внешних 15 проходов KB загружен 6149..7D33, код 6149..615D цел, регистровые
   9++6149              ;   аргументы не требуются
  10++6149              ; Out:
  11++6149              ;   615E..7D32 расшифрованы собственным R-XOR, первый ключ 54 и шаг 9 по модулю 128, последний
  12++6149              ;   байт 7D33 не меняется, вход в 615E с HL=7D33, BC=0, A=0, R=4F, DE, SP, IX, IY сохранены
  13++6149              ; Corrupt:
  14++6149              ;   HL, BC, AF, R, память 615E..7D32, прерывания запрещены через DI
  15++6149              ; -----------------------------------------
  16++6149 F3           DecodeBoot      DI
  17++614A 3E 50                        LD A, #50
  18++614C ED 4F                        LD R, A
  19++614E 21 5E 61                     LD HL, Startup.Entry                                            ; первый байт расшифровываемого основного кода BL3
  20++6151 01 D5 1B                     LD BC, #1BD5
  21++6154 ED 5F        .DecodeByte     LD A, R
  22++6156 AE                           XOR (HL)
  23++6157 77                           LD (HL), A
  24++6158 23                           INC HL
  25++6159 0B                           DEC BC
  26++615A 78                           LD A, B
  27++615B B1                           OR C
  28++615C 20 F6                        JR NZ, .DecodeByte                                              ; переход, если остались незакодированные байты загрузочного блока
  29++615E
# file closed: Source/Startup/DecodeBoot.asm
   4++615E                              include "Source/Startup/Entry.asm"
