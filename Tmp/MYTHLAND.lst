   1++6161
   2++6161              ; -----------------------------------------
   3++6161              ; обработать кадровое прерывание начального модуля
   4++6161              ; сохраняет основные, альтернативные и индексные регистры и текущий банк памяти
   5++6161              ; сохраняет операнды DrawGlyph.SelectCall и RestoreCall на время фоновых обработчиков
   6++6161              ; EditFlags разрешает мигание текстового курсора, CursorTimer задаёт период смены CursorGlyph
   7++6161              ; TickIntroText выводит текст создания игры, Rom.ScanKeys128 обслуживает клавиатуру ПЗУ 128
   8++6161              ; затем восстанавливает операнды, банк и регистры и возвращается через EI, RETI
   9++6161              ; In:
  10++6161              ;   аппаратный адрес возврата на стеке, установлены Memory.SelectBank и фоновые обработчики
  11++6161              ; Out:
  12++6161              ;   HL, DE, BC, AF, HL', DE', BC', AF', IX, IY восстановлены, исходный банк восстановлен
  13++6161              ; Corrupt:
  14++6161              ;   R, IFF, CursorTimer и CursorGlyph при разрешённом мигании, экран курсора и плеер
  15++6161              ; -----------------------------------------
  16++6161 E5           Interrupt       PUSH HL
  17++6162 D5                           PUSH DE
