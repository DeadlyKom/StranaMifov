   1++7196
   2++7196              ; -----------------------------------------
   3++7196              ; периодический вывод и прокрутка текста во время создания новой игры
   4++7196              ; Если #7219 ненулевой, сразу возвращается. Каждые 6 вызовов уменьшает второй счётчик, раз в 8
   5++7196              ; таких шагов очищает 38 знаков строки 18 и печатает очередную строку из банка 6 по указателю
   6++7196              ; #721C до CR. Маркер #B0 устанавливает #7219=#FF и завершает обработку. На остальных активных
   7++7196              ; шагах прокручивает область от #40A2 вверх на один пиксель, 14 рядов знакомест, 7 копирований по
   8++7196              ; 28 байтов и переход по 30 байтов к следующему ряду. Внешний обработчик прерываний сохраняет
   9++7196              ; регистры и банк, сама процедура этого полного сохранения не делает.
  10++7196              ; In:
  11++7196              ;   #7219 — разрешение/завершение, #721A/#721B — счётчики, #721C — текстовый указатель
  12++7196              ; Out:
  13++7196              ;   при маркере #B0 #7219=#FF, иначе очередной шаг прокрутки
  14++7196              ; Corrupt:
  15++7196              ;   HL, DE, BC, AF, IX
  16++7196              ; Note:
  17++7196              ;   экран, банк 6, #7219..#721F
  18++7196              ; -----------------------------------------
  19++7196 3A 19 72     TickIntroText   LD A, (Startup.TickIntroText.Stopped)
  20++7199 B7                           OR A
  21++719A C0                           RET NZ                                                          ; выход, если вступительный текст остановлен или уже завершён
  22++719B DD 21 1A 72                  LD IX, Startup.TickIntroText.Timers
