 526+ E4F2 29                           ADD HL, HL
 527+ E4F3 06 00                        LD B, #00
 528+ E4F5 09                           ADD HL, BC
 529+ E4F6 01 00 58                     LD BC, Screen.Attributes                                        ; начало видимой области атрибутов Spectrum
 530+ E4F9 09                           ADD HL, BC
 531+ E4FA 42                           LD B, D
 532+ E4FB C5           .AttrRow        PUSH BC
 533+ E4FC E5                           PUSH HL
 534+ E4FD 43                           LD B, E
 535+ E4FE 77           .AttrColumn     LD (HL), A
 536+ E4FF 23                           INC HL
 537+ E500 10 FC                        DJNZ .AttrColumn
 538+ E502 E1                           POP HL
 539+ E503 01 20 00                     LD BC, #0020
 540+ E506 09                           ADD HL, BC
 541+ E507 C1                           POP BC
