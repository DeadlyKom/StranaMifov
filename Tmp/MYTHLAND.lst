   1++0000              ; исходная стратегическая запись отряда
   2++0000                              struct FTroop
   3++0000 ~
   4++0000 ~            ; -----------------------------------------
   5++0000 ~            ; FTroop.ID, смещение +#00, обычный ID и временные отметки TickTime
   6++0000 ~            ;      7    6    5    4    3    2    1    0
   7++0000 ~            ;   +----+----+----+----+----+----+----+----+
   8++0000 ~            ;   | AT | RU | DW | ID | ID | ID | ID | ID |
   9++0000 ~            ;   +----+----+----+----+----+----+----+----+
  10++0000 ~            ;
  11++0000 ~            ;   флаги и поля:
  12++0000 ~            ;   AT       [7]      - флаг, временная отметка атакующего отряда, также ставится при совпадении
  13++0000 ~            ;     секты
  14++0000 ~            ;   RU       [6]      - флаг, временная отметка сбежавшего отряда в финансовой ветви
  15++0000 ~            ;   DW       [5]      - флаг, временная отметка утонувшего отряда в корабельном событии
  16++0000 ~            ;   ID       [4..0]   - поле, ID типа существа 1..25, 0 завершает плотный список
  17++0000 ~            ; Вне указанных промежуточных ветвей поле остаётся обычным идентификатором
  18++0000 ~            ; Это не набор постоянных свойств типа, постоянные способности лежат в FSoldier
  19++0000 ~            ; Проверено по потребителям:
  20++0000 ~            ;   Source/Engine/TickTime.asm, #9B07/#9B4B/#9A15/#9A17/#9A19/#9B5C/#9B0C/#9B0E/#9B14/#9B72/#9AA1/#9AA6/#9B10/#9B67
  21++0000 ~            ; -----------------------------------------
  22++0000 ~            ID              DB #00                                                          ; ID типа отряда, 0 завершает плотный список. В финансовом проходе #9B10/#9B14 временно устанавливаются биты 7/6, поэтому не во всех промежуточных состояниях байт является чистым ID
  23++0000 ~            Count           FWord                                                           ; беззнаковая численность little-endian
  24++0000                              ends
  25++0000                              assert FTroop = 3
