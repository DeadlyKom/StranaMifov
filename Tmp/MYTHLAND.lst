   1++6573
   2++6573              ; -----------------------------------------
   3++6573              ; шлюз TR-DOS с перехватом ошибок и служебных возвратов
   4++6573              ; Сохраняет SP и ERR_SP (System.ErrorSP), создаёт временный стек у #FFFF, направляет ERR_SP в
   5++6573              ; DosErrorReturn. В
   6++6573              ; TrDos.ReturnHook ставит JP DosReturnHook, вызывает TrDos.Service, затем восстанавливает стек и
   7++6573              ; ERR_SP, возвращает TrDos.ReturnHook в
   8++6573              ; RET.
   9++6573              ; In:
  10++6573              ;   HL — буфер, DE — дисковая позиция, BC — аргументы TR-DOS, IY указывает системные переменные
  11++6573              ; Out:
  12++6573              ;   A=0 обычный возврат, A=1..3 перехваченная ошибка
  13++6573              ; Corrupt:
  14++6573              ;   HL, DE, BC, AF по TR-DOS
  15++6573              ; Note:
  16++6573              ; самомодификация CallDosIO.DosBuffer/CallDosIO.SavedSP/CallDosIO.SavedErrSP, временный SP,
  17++6573              ; System.ErrorSP, TrDos.ReturnHook..#5CC4
  18++6573              ; -----------------------------------------
  19++6573
  20++6573                              ; временный стек и ERR_SP позволяют перехватить выходы TR-DOS, не отдавая ошибку
  21++6573                              ; в BASIC
  22++6573 ED 73 A2 65  CallDosIO       LD (CallDosIO.SavedSP), SP
  23++6577 22 9B 65                     LD (CallDosIO.DosBuffer), HL
  24++657A 31 00 00                     LD SP, #0000
  25++657D 2A 3D 5C                     LD HL, (System.ErrorSP)
  26++6580 22 A5 65                     LD (CallDosIO.SavedErrSP), HL
  27++6583 21 B2 65                     LD HL, DosErrorReturn
  28++6586 E5                           PUSH HL
  29++6587 ED 73 3D 5C                  LD (System.ErrorSP), SP
  30++658B FD 36 00 FF                  LD (IY), #FF                                                    ; ERR_NR, удалить прежний номер ошибки перед вызовом DOS
  31++658F 21 B6 65                     LD HL, DosReturnHook
  32++6592 3E C3                        LD A, #C3
  33++6594 32 C2 5C                     LD (TrDos.ReturnHook), A
  34++6597 22 C3 5C                     LD (TrDos.ReturnTarget), HL
  35++659A 21 00 00                     LD HL, #0000
  36++659D              .DosBuffer      EQU $ - 2                                                       ; операнд указателя буфера перед CALL TR-DOS
  37++659D CD 13 3D                     CALL TrDos.Service                                              ; вызов сервиса TR-DOS, номер операции находится в C
  38++65A0 AF                           XOR A
  39++65A1
  40++65A1                              ; единая ветвь возвращает исходные SP и ERR_SP и отключает временный перехват по
  41++65A1                              ; TrDos.ReturnHook
  42++65A1 31 00 00     .RestoreStack   LD SP, #0000
  43++65A4              .SavedSP        EQU $ - 2                                                       ; операнд восстановления стека после TR-DOS
  44++65A4 21 00 00                     LD HL, #0000
  45++65A7              .SavedErrSP     EQU $ - 2                                                       ; операнд восстановления ERR_SP после TR-DOS
  46++65A7 22 3D 5C                     LD (System.ErrorSP), HL
  47++65AA F5                           PUSH AF
  48++65AB 3E C9                        LD A, #C9
  49++65AD 32 C2 5C                     LD (TrDos.ReturnHook), A
  50++65B0 F1                           POP AF
  51++65B1 C9                           RET
