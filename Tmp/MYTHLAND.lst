   3++6171              ; расшифровка меню с подменой канала вывода BASIC
   4++6171              ; Сохраняет CURCHL из System.CurrentChannel в операнде DecodeMenu.SavedChannel и заменяет его на
   5++6171              ; указатель #61A6, содержащий PrintHook.
   6++6171              ; Инициализирует R=#59 и обрабатывает #157D байтов MainMenu..Loader.Menu.UnitBuffer
   7++6171              ; включительно. Ключ образуется
   8++6171              ; показаниями R, байтами адреса, остатком DE и дополнительным XOR внутри перехватчика RST #10.
   9++6171              ; Вызов проходит через настоящий путь ПЗУ #0010/#15F2/#162C, поэтому число M1-выборок входит в
  10++6171              ; ключ. После расшифровки восстанавливает HL из сохранённого операнда и передаёт управление
  11++6171              ; MainMenu.
  12++6171              ; На этом участке CURCHL остаётся подменённым.
  13++6171              ; In:
  14++6171              ;   System.CurrentChannel — исходный канал вывода, стандартное ПЗУ 48
  15++6171              ; Out:
  16++6171              ;   открытый код меню по MainMenu
  17++6171              ; Corrupt:
  18++6171              ;   HL, DE, BC, AF, HL', DE', BC', AF', R
  19++6171              ; -----------------------------------------
  20++6171 F3           DecodeMenu      DI
  21++6172 2A 51 5C                     LD HL, (System.CurrentChannel)
  22++6175 22 98 61                     LD (DecodeMenu.SavedChannel), HL
