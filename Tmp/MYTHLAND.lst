 381+ B5F7              ;   A — байт клетки
 382+ B5F7              ; Out:
 383+ B5F7              ;   A=исходное A AND #3F, Z по этому значению
 384+ B5F7              ; Corrupt:
 385+ B5F7              ;   AF. HL, DE, BC, HL', DE', BC', AF', IX, IY сохранены
 386+ B5F7              ; Note:
 387+ B5F7              ;   AF
 388+ B5F7              ; -----------------------------------------
