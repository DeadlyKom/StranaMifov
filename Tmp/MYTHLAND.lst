  29++65EC 38 2B                        JR C, ShowDiskError.FileOffset                                  ; переход, если файл найден и можно вычислить адрес нужного сектора
  30++65EE 21 2B 67                     LD HL, Loader.Menu.SelectDrive.MissingText                      ; сообщение о ненайденном файле
