   3++7461              ; выбор прямоугольной области меню пиксельным курсором
   4++7461              ; Убирает оставшееся вращение образцов по #770A, выравнивает их на начальный x и копирует его в
   5++7461              ; старую/новую позицию. Сохраняет фон, проверяет область под курсором и выделяет её обменом
   6++7461              ; INK/PAPER. Цикл сравнивает новый указатель области с предыдущим #763F, снимает старое выделение
   7++7461              ; и ставит новое. После HALT восстанавливает старый фон, сохраняет новый, рисует курсор и
   8++7461              ; переносит позицию в #76BE. Коды управления перемещают по 1 пикселю, включая диагонали. Код #27
   9++7461              ; выбирает только существующую область. Перед возвратом убирает подсветку и курсор, сохраняет
  10++7461              ; позицию в дескрипторе.
  11++7461              ; In:
  12++7461              ;   IX — дескриптор, число областей, +1minX, +2minY, +3maxX, +4maxY, +5currentX, +6currentY,
  13++7461              ;   далее четверки left, top, right, bottom в знакоместах
  14++7461              ; Out:
  15++7461              ;   A — номер выбранной области с 1, IX остаётся дескриптором, его+5/+6 содержат позицию
  16++7461              ; Corrupt:
  17++7461              ;   HL, DE, BC, AF, IY, прерывания EI
  18++7461              ; Note:
  19++7461              ;   экран, #763F, #76BE..#770A, координаты дескриптора
