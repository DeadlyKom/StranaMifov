  30++6171 3A A0 5F                     LD A, (Memory.CurrentBank)
  31++6174 F5                           PUSH AF
  32++6175 2A FE 6D                     LD HL, (Startup.DrawGlyph.SelectCall)
  33++6178 E5                           PUSH HL
  34++6179 2A 50 6E                     LD HL, (Startup.DrawGlyph.RestoreCall)
  35++617C E5                           PUSH HL
  36++617D 3A D5 61                     LD A, (Startup.Interrupt.EditFlags)
  37++6180 CB 6F                        BIT 5, A
  38++6182 28 23                        JR Z, .TickIntroText                                            ; переход, если редактор не разрешает мигание текстового курсора
  39++6184 3A D0 61                     LD A, (Startup.Interrupt.CursorTimer)
  40++6187 B7                           OR A
  41++6188 20 0F                        JR NZ, .CursorTick                                              ; переход, если таймер курсора ещё не истёк
  42++618A 3A D1 61                     LD A, (Startup.Interrupt.CursorGlyph)
  43++618D FE F5                        CP #F5
  44++618F 20 02                        JR NZ, .NextCursorChar                                          ; переход, если текущий символ курсора отличается от F5
  45++6191 3E F1                        LD A, #F1
  46++6193 3C           .NextCursorChar INC A
  47++6194 32 D1 61                     LD (Startup.Interrupt.CursorGlyph), A
  48++6197 3E 07                        LD A, #07
  49++6199 3D           .CursorTick     DEC A
  50++619A 32 D0 61                     LD (Startup.Interrupt.CursorTimer), A
  51++619D ED 4B D2 61                  LD BC, (Startup.Interrupt.CursorPos)
  52++61A1 3A D1 61                     LD A, (Startup.Interrupt.CursorGlyph)
  53++61A4 CD 97 6E                     CALL DrawGlyphNoEI                                              ; нарисовать символ без дополнительного EI в обёртке переключения банка
  54++61A7 CD 96 71     .TickIntroText  CALL TickIntroText                                              ; периодический вывод и прокрутка текста во время создания новой игры
  55++61AA FD 21 3A 5C                  LD IY, System.FlagsAnchor                                       ; системная база IY перед вызовами TR-DOS или128ROM
