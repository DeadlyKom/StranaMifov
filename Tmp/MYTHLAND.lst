   1++65B6
   2++65B6              ; -----------------------------------------
   3++65B6              ; перехват возвратов TR-DOS через TrDos.ReturnHook
   4++65B6              ; Меняет HL с вершиной стека и проверяет адрес возврата. Для #0D6B формирует код 2 или 3 по
   5++65B6              ; TrDos.IOMode
   6++65B6              ; и покидает шлюз. Для #1F54 заменяет адрес на #653C, что приводит к успешному выходу поиска.
   7++65B6              ; Остальные возвраты сохраняет.
   8++65B6              ; In:
   9++65B6              ;   стек вызова TR-DOS, TrDos.IOMode
  10++65B6              ; Out:
  11++65B6              ;   изменённый адрес возврата или выход через CallDosIO.RestoreStack
  12++65B6              ; Corrupt:
  13++65B6              ;   HL, AF временно сохраняются, состояние прерываний DI
  14++65B6              ; Note:
  15++65B6              ;   вершина стека
  16++65B6              ; -----------------------------------------
  17++65B6
  18++65B6                              ; шлюз распознаёт конкретные адреса возврата ROM TR-DOS, этот контракт зависит
  19++65B6                              ; от версии ROM
  20++65B6 F3           DosReturnHook   DI
  21++65B7 E3                           EX (SP), HL
  22++65B8 F5                           PUSH AF
  23++65B9 7C                           LD A, H
  24++65BA FE 0D                        CP #0D
  25++65BC 20 10                        JR NZ, .CheckFoundFile                                          ; переход, если адрес возврата не соответствует перехватываемой ошибке TR-DOS
  26++65BE 7D                           LD A, L
  27++65BF FE 6B                        CP #6B
  28++65C1 20 0B                        JR NZ, .CheckFoundFile                                          ; переход, если адрес возврата не соответствует перехватываемой ошибке TR-DOS
  29++65C3 3A CE 5C                     LD A, (TrDos.IOMode)
  30++65C6 B7                           OR A
  31++65C7 3E 02                        LD A, #02
  32++65C9 28 D6                        JR Z, CallDosIO.RestoreStack                                    ; переход, если прервана операция чтения, вернуть код ошибки 2
  33++65CB 3C                           INC A
  34++65CC 18 D3                        JR CallDosIO.RestoreStack
  35++65CE 7C           .CheckFoundFile LD A, H
  36++65CF FE 1F                        CP #1F
  37++65D1 20 08                        JR NZ, .ReturnToDos                                             ; переход, если возврат не требует подмены обработчиком поиска файла
  38++65D3 7D                           LD A, L
  39++65D4 FE 54                        CP #54
  40++65D6 20 03                        JR NZ, .ReturnToDos                                             ; переход, если возврат не требует подмены обработчиком поиска файла
  41++65D8 21 3C 65                     LD HL, Loader.Menu.FindFile.Found                               ; SCF нормального завершения FindFile, используется перехватом возврата TR-DOS
  42++65DB F1           .ReturnToDos    POP AF
  43++65DC E3                           EX (SP), HL
  44++65DD C9                           RET
