 224  ED0A                              ; компиляция блока S33 и размещение по исходному смещению диска
 225  ED0A                              include "Source/Files/33_BL1.asm"
# file opened: Source/Files/33_BL1.asm
   1+ ED0A              ; первая банка изображений с распаковщиком
   2+ ED0A              ; исходный файл каталога 33, смещение #0000
   3+ ED0A                              module Graphics
   4+ ED0A                              module Scenes1
   5+ ED0A                              org #C000
   6+ C000
   7+ C000              ; -----------------------------------------
   8+ C000              ; вход в самоперемещаемый распаковщик банка изображений
   9+ C000              ; JR пропускает четыре байта настроек по смещениям 2..5. Вызывающий код записывает номер картинки
  10+ C000              ; в смещение 2. Дальше исполняется общий алгоритм по адресу начала+6.
  11+ C000              ; In:
  12+ C000              ;   Draw.Picture — номер изображения от 1
  13+ C000              ; Out:
  14+ C000              ;   переход к началу+6
  15+ C000              ; Corrupt:
  16+ C000              ;   HL, DE, BC, AF, BC', IY. HL', DE', AF', IX сохранены, SP возвращается к входной позиции до
  17+ C000              ;   RET
  18+ C000              ; -----------------------------------------
  19+ C000 18 04        Draw            JR Unpack
  20+ C002
  21+ C002 01           .Picture        DB #01                                                          ; номер изображения, FRleState.Picture
  22+ C003 FF           .FirstThird     DB #FF                                                          ; начальная треть экрана, #FF брать из заголовка
  23+ C004 FF           .ThirdCount     DB #FF                                                          ; число третей экрана, #FF брать из заголовка
  24+ C005 0C           .Flags          DB #0C                                                          ; флаги распаковщика, FRleState.Flags
  25+ C006              ; -----------------------------------------
  26+ C006              ; выбор изображения, RLE-распаковка пикселей и атрибутов
  27+ C006              ; CALL #007C использует RET в ПЗУ, оставшийся в стеке адрес позволяет вычислить собственную базу и
  28+ C006              ; IY=начало+2. По цепочке относительных длин начиная с IY+#012A выбирается изображение. Поток
  29+ C006              ; содержит начальную треть экрана, число третей и флаги. Координаты ограничиваются диапазоном
