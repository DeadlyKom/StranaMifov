   7+ B200              ; -----------------------------------------
   8+ B200              ; трёхстраничная справка об управлении
   9+ B200              ; Очищает экран и последовательно выводит строки по #B2A0, #B433, #B56F. Первые страницы описывают
  10+ B200              ; управление героем/меню, третья — клавиши боя. После первых двух вызывает WaitHelpPage, после
  11+ B200              ; последней
  12+ B200              ; показывает «Вот и все», ждёт ввода и восстанавливает основной экран.
  13+ B200              ; In:
  14+ B200              ;   нет явных аргументов
  15+ B200              ; Out:
  16+ B200              ;   возврат после третьей страницы
  17+ B200              ; Corrupt:
  18+ B200              ;   HL, DE, BC, AF, HL', DE', BC', AF', IX, IY через заключительное восстановление основного
  19+ B200              ;   экрана #944A, собственный вывод справки сохраняет индексные регистры до этого вызова
  20+ B200              ; Note:
  21+ B200              ;   экран, состояние общих процедур печати
  22+ B200              ; -----------------------------------------
  23+ B200 CD 34 6D     Entry           CALL Engine.StopView                                            ; выключить обработку объектов в прерывании
  24+ B203 CD 3F 6D                     CALL Engine.ResetViewFlags                                      ; сбросить младшие шесть флагов 48 записей объектов
  25+ B206 01 00 00                     LD BC, #0000
  26+ B209 11 20 18                     LD DE, #1820
  27+ B20C 3E 46                        LD A, #46
  28+ B20E CD CF 73                     CALL Engine.ClearRectangle                                      ; обнулить пиксели прямоугольника и заполнить его атрибуты
  29+ B211 06 01                        LD B, #01
  30+ B213 11 A0 B2                     LD DE, Overlay.Help.WaitHelpPage.MovementText                   ; страница справки о перемещении героя и указателя меню
  31+ B216 CD 17 71                     CALL Engine.PrintMessage                                        ; разобрать строку сообщения с управляющими кодами
  32+ B219 CD 61 B2                     CALL WaitHelpPage
  33+ B21C 01 00 00                     LD BC, #0000
  34+ B21F 11 20 18                     LD DE, #1820
  35+ B222 3E 46                        LD A, #46
  36+ B224 CD CF 73                     CALL Engine.ClearRectangle                                      ; обнулить пиксели прямоугольника и заполнить его атрибуты
  37+ B227 06 01                        LD B, #01
  38+ B229 11 33 B4                     LD DE, Overlay.Help.WaitHelpPage.WorldKeysText                  ; страница справки о клавишах на карте мира
  39+ B22C CD 17 71                     CALL Engine.PrintMessage                                        ; разобрать строку сообщения с управляющими кодами
  40+ B22F CD 61 B2                     CALL WaitHelpPage
  41+ B232 01 00 00                     LD BC, #0000
  42+ B235 11 20 18                     LD DE, #1820
  43+ B238 3E 46                        LD A, #46
  44+ B23A CD CF 73                     CALL Engine.ClearRectangle                                      ; обнулить пиксели прямоугольника и заполнить его атрибуты
  45+ B23D 06 01                        LD B, #01
  46+ B23F 11 6F B5                     LD DE, Overlay.Help.WaitHelpPage.BattleKeysText                 ; страница справки о клавишах боя
  47+ B242 CD 17 71                     CALL Engine.PrintMessage                                        ; разобрать строку сообщения с управляющими кодами
  48+ B245 01 00 17                     LD BC, #1700
  49+ B248 11 20 01                     LD DE, #0120
  50+ B24B 3E 42                        LD A, #42
  51+ B24D CD AD 73                     CALL Engine.FillAttributes                                      ; заполнить прямоугольник атрибутов цветом A
  52+ B250 06 17                        LD B, #17
  53+ B252 11 93 B2                     LD DE, Overlay.Help.WaitHelpPage.EndText                        ; сообщение о завершении справки
  54+ B255 CD 17 71                     CALL Engine.PrintMessage                                        ; разобрать строку сообщения с управляющими кодами
  55+ B258 06 00                        LD B, #00
  56+ B25A CD F4 7B                     CALL Engine.WaitOrInput                                         ; выдержать паузу с досрочным выходом по вводу
  57+ B25D CD 4A 94                     CALL Engine.RefreshPanels                                       ; перерисовать верхнюю строку и боковую панель игры
  58+ B260 C9                           RET
