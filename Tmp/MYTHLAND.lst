   3++7117              ; разобрать строку сообщения с управляющими кодами
   4++7117              ; DE строка, IX указатель разбора, #0E вставляет строку по 16-битному адресу, #0F вставляет целое,
   5++7117              ; #10 вставляет пятибайтное число, #11 меняет формат, #0D завершает строку, 0 завершает сообщение,
   6++7117              ; промежуточный буфер #72B3
   7++7117              ; In:
   8++7117              ;   DE сообщение с управляющими кодами и нулевым терминатором, BC, B начальная строка и C
   9++7117              ;   начальная колонка
  10++7117              ; Out:
  11++7117              ;   сообщение выведено, HL, DE, BC, AF, IX, IY сохранены
  12++7117              ; Corrupt:
  13++7117              ;   HL, DE, BC, AF, IX, IY сохранены, рабочий буфер #72B3 и форматные операнды изменены,
  14++7117              ;   числовые вставки используют ROM, альтернативные HL', DE', BC', AF' зависят от внутреннего
  15++7117              ;   соглашения ROM и отдельно не проверены
  16++7117              ; Note:
  17++7117              ;   Числовые управляющие поля имеют служебный пропускаемый байт, после #0F читаются двабайта
  18++7117              ;   целого и указатель дополнительно увеличивается ещё наодинбайт, после #10 читаются пятьбайт
  19++7117              ;   числа и также пропускается одинбайт. Код #0D читает следующий байт горизонтальной позиции,
  20++7117              ;   значение #2A включает центрирование. Буфер строки 43 байта очищается, явной проверки его
  21++7117              ;   переполнения нет.
