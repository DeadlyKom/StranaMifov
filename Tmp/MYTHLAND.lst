  27++64C9 21 A7 66                     LD HL, Loader.Menu.SelectDrive.UnitsFile                        ; девятибайтное имя SOLDIERS для редактора и записи настроек
  28++64CC 11 24 77                     LD DE, Loader.Menu.UnitBuffer
  29++64CF 01 06 FF                     LD BC, #FF06
  30++64D2 AF                           XOR A
  31++64D3 CD DE 65                     CALL AccessFile                                                 ; операция с файлом по имени и смещению в секторах
  32++64D6
  33++64D6                              ; режим деградации хранится в отдельном секторе head.co и записывается
  34++64D6                              ; независимо от SOLDIERS
  35++64D6 F1           .CheckDegrade   POP AF
