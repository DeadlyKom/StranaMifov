   4++6508              ; Читает восемь секторов каталога в #D800, затем просматривает до 127 записей по 16 байтов.
   5++6508              ; Нулевая первая буква завершает поиск, #01 означает удалённый файл. Сравнивает имя 8 байтов и тип
   6++6508              ; с TrDos.Descriptor, найденный 16-байтовый дескриптор копирует туда целиком.
   7++6508              ; In:
   8++6508              ;   TrDos.Descriptor..#5CE5 — имя и тип
   9++6508              ; Out:
  10++6508              ;   CF=1 найдено, CF=0 не найдено, IX — запись
  11++6508              ; Corrupt:
  12++6508              ;   HL, DE, BC, AF, IX
