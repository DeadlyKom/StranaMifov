   3++61A8              ; вход в скрытое меню дисковой версии
   4++61A8              ; Сохраняет исходный SP, запоминает текущий привод TR-DOS, выбирает привод 0, запускает AY-плеер,
   5++61A8              ; устанавливает IM 2. Очищает экран, рисует окно и три пункта. Обрабатывает выбор, возвращая
   6++61A8              ; управление в главное меню после описания или редактора.
   7++61A8              ; In:
   8++61A8              ;   SP — стек вызывающего BASIC, TrDos.Drive — текущий привод
   9++61A8              ; Out:
  10++61A8              ;   после выбора игры управление передаётся StartGame
  11++61A8              ; Corrupt:
  12++61A8              ;   HL, DE, BC, AF, HL', DE', BC', IX, IY, I, режим прерываний
  13++61A8              ; Note:
  14++61A8              ; SaveAYState.MenuStack — сохранённый SP, SelectDrive.Drive — привод, SelectDrive.MenuCursor —
  15++61A8              ; начальная позиция курсора
  16++61A8              ; -----------------------------------------
  17++61A8 ED 73 19 64  MainMenu        LD (SaveAYState.MenuStack), SP
  18++61AC 3A 16 5D                     LD A, (TrDos.Drive)
  19++61AF 32 72 66                     LD (SelectDrive.Drive), A
  20++61B2 AF                           XOR A
  21++61B3 CD 66 66                     CALL SelectDrive                                                ; установка текущего привода TR-DOS
  22++61B6 CD 00 E0                     CALL Music.Menu.InitMenuMusic                                   ; внешний вход запуска музыки скрытого меню
  23++61B9 CD 4E 64                     CALL RestoreAYState                                             ; установка IM 2 и восстановление регистров AY
  24++61BC 21 60 48                     LD HL, #4860
  25++61BF 22 35 69                     LD (SelectDrive.MenuCursor), HL
  26++61C2 3E 01        .ResetBorder    LD A, #01
  27++61C4 32 4C 6C                     LD (MenuState.PortFE), A
  28++61C7 D3 FE                        OUT (#FE), A
  29++61C9 3E 0F        .DrawMenu       LD A, #0F
  30++61CB CD 31 66                     CALL ClearScreen                                                ; очистка экранной памяти и заполнение атрибутов
  31++61CE DD 21 C0 66                  LD IX, Loader.Menu.SelectDrive.MainWindow                       ; семибайтный описатель главного окна FMenuWindow
  32++61D2 CD 86 6C                     CALL DrawWindow                                                 ; рисование окна по дескриптору
  33++61D5 21 7D 67                     LD HL, Loader.Menu.SelectDrive.MainText                         ; надписи трёх пунктов главного меню
  34++61D8 CD 67 6D                     CALL PrintString                                                ; печать строки с управляющими кодами
  35++61DB 2A 35 69                     LD HL, (SelectDrive.MenuCursor)
  36++61DE 22 74 6C                     LD (MenuState.CursorXY), HL
  37++61E1 21 D3 68                     LD HL, Loader.Menu.SelectDrive.MainAreas                        ; прямоугольные области выбора трёх пунктов главного меню
  38++61E4 CD B4 6A                     CALL BeginMenu                                                  ; подготовка выбора пункта меню курсором
  39++61E7
  40++61E7                              ; пункты обрабатываются только при подтверждённом выборе, нажатие вне областей
  41++61E7                              ; меню игнорируется
  42++61E7 CD D5 6A     .PollChoice     CALL PollMenu                                                   ; один шаг ожидания выбора в меню
  43++61EA 30 FB                        JR NC, .PollChoice                                              ; переход, если пункт ещё не подтверждён
  44++61EC 3C                           INC A
  45++61ED 28 F8                        JR Z, .PollChoice                                               ; переход, если подтверждение произошло вне пунктов меню
  46++61EF F5                           PUSH AF
