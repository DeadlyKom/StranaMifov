   2++D255              ; -----------------------------------------
   3++D255              ; выполнить бой на поле 8 на 5 клеток
   4++D255              ; сохраняет SP в E0BD и вызывает FAAF, на каждом раунде восстанавливает движения из +7 в +12,
   5++D255              ; уменьшает длительность эффектов +13, выбирает ещё не ходивший отряд по биту 3 поля +9, бунтующий
   6++D255              ; отряд с битом 7 может перейти к противнику или объединиться с таким же типом, восемь направлений
   7++D255              ; разрешают движение в свободную клетку либо рукопашную атаку, S запускает стрельбу, F полёт, U
   8++D255              ; меню заклинаний, G откуп, W откладывает ход, Space обнуляет остаток действий, E0BF выполняет ход
   9++D255              ; компьютера, F6B8 может выйти из боя непосредственно через сохранённый SP, ветка откупа DA9E
  10++D255              ; записывает армии обратно и возвращает FF
  11++D255              ; In:
  12++D255              ;   DE сила противника, BC число исходных отрядов и банк, A тип боя, IX исходная армия
  13++D255              ;   противника
  14++D255              ; Out:
  15++D255              ;   DE остаток FCB9, A=0 победа, A=FF поражение или откуп, армии записаны через 88FA
  16++D255              ; Corrupt:
  17++D255              ;   HL, DE, BC, AF, IX, IY, SP на путях завершения боя, обе армии, боевые переменные, объекты и
  18++D255              ;   экран, состояние калькулятора и генератора случайных чисел
  19++D255              ; -----------------------------------------
  20++D255 ED 73 BD E0  Battle          LD (Battle.ReadCursorInput.SavedStack), SP
  21++D259 CD AF FA                     CALL InitBattle                                                 ; инициализировать армии, препятствия, фон и начальные объекты боя
  22++D25C FD 21 ED FC  .NewRound       LD IY, Battle.FinishField.HeroArmy
  23++D260 CD 56 F5                     CALL ResetTurnFlags                                             ; очистить временные флаги одной армии
  24++D263 CD 78 F5                     CALL RestoreMovement                                            ; восстановить очки движения армии на новый раунд
  25++D266 3A E7 FC                     LD A, (Battle.FinishField.Flags)
  26++D269 CB 97                        RES 2, A
  27++D26B 32 E7 FC                     LD (Battle.FinishField.Flags), A
  28++D26E FD 21 ED FC                  LD IY, Battle.FinishField.HeroArmy
  29++D272 CD F0 F5                     CALL TickEffects                                                ; уменьшить длительность временных эффектов одной армии
  30++D275 FD 21 47 FD                  LD IY, Battle.FinishField.EnemyArmy
  31++D279 CD F0 F5                     CALL TickEffects                                                ; уменьшить длительность временных эффектов одной армии
  32++D27C ED 4B 3C CF                  LD BC, (Data.Battle.MagicWard.ManaCost)
  33++D280 2A 04 6A                     LD HL, (State.Mana)
  34++D283 3A E7 FC                     LD A, (Battle.FinishField.Flags)
  35++D286 CB 47                        BIT 0, A
  36++D288 28 12                        JR Z, .EnemyWardCost                                            ; переход, если щит героя отключён
  37++D28A ED 42                        SBC HL, BC
  38++D28C 22 04 6A                     LD (State.Mana), HL
  39++D28F 30 0B                        JR NC, .EnemyWardCost                                           ; переход, если маны героя хватает на очередную оплату щита
  40++D291 21 00 00                     LD HL, #0000
  41++D294 22 04 6A                     LD (State.Mana), HL
  42++D297 CB 87                        RES 0, A
  43++D299 32 E7 FC                     LD (Battle.FinishField.Flags), A
  44++D29C 2A B9 FC     .EnemyWardCost  LD HL, (Battle.FinishField.EnemyMana)
  45++D29F CB 4F                        BIT 1, A
  46++D2A1 28 12                        JR Z, SelectActor                                               ; переход, если щит противника отключён
  47++D2A3 ED 42                        SBC HL, BC
  48++D2A5 22 B9 FC                     LD (Battle.FinishField.EnemyMana), HL
  49++D2A8 30 0B                        JR NC, SelectActor                                              ; переход, если маны противника хватает на очередную оплату щита
  50++D2AA 21 00 00                     LD HL, #0000
  51++D2AD 22 B9 FC                     LD (Battle.FinishField.EnemyMana), HL
