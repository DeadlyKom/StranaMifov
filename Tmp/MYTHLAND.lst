   3++7311              ; восстановление полного экрана из сохранённого фона в банк 4
   4++7311              ; Сохраняет номер текущего банка из #5FA0, выбирает банк 4 и копирует #1B00 байтов из #C000 в
   5++7311              ; #4000. Возвращает исходный банк. Копируются и 6144 пиксельных байта, и 768 атрибутов.
   6++7311              ; In:
   7++7311              ;   банк 4, #C000..#DAFF — исходный экран
   8++7311              ; Out:
   9++7311              ;   текущий банк восстановлен
  10++7311              ; Corrupt:
  11++7311              ;   HL, DE, BC, AF
  12++7311              ; Note:
  13++7311              ;   #4000..#5AFF
  14++7311              ; -----------------------------------------
  15++7311 3A A0 5F     RestoreScreen   LD A, (Memory.CurrentBank)
  16++7314 F5                           PUSH AF
  17++7315 3E 04                        LD A, #04
  18++7317 CD A1 5F                     CALL Memory.SelectBank                                          ; переключение логического банка через установленный драйвер памяти
  19++731A 21 00 C0                     LD HL, Presentation.screen                                      ; первые6912байтов PRES в банке4 служат сохранённым фоном меню
  20++731D 11 00 40                     LD DE, Screen.Pixels                                            ; начало видимой пиксельной памяти экрана
  21++7320 01 00 1B                     LD BC, #1B00
  22++7323 ED B0                        LDIR
  23++7325 F1                           POP AF
  24++7326 CD A1 5F                     CALL Memory.SelectBank                                          ; переключение логического банка через установленный драйвер памяти
  25++7329 C9                           RET
