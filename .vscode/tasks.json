{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "process",
            "command": "./Tools/Sjasmplus/sjasmplus.exe",
            "args": [
                "--fullpath=rel",
                "--lst=Tmp/MYTHLAND.lst",
                "--sym=Tmp/MYTHLAND.sym",
                "Builder/Main.asm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "sjasmplus",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+)\\((\\d+)\\):\\s+(warning|error)(?:\\[[^\\]]+\\])?:\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        }
    ]
}
