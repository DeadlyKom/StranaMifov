                module MapConst
Width           EQU 161                                                         ; число колонок континента
Height          EQU 100                                                         ; число строк континента

; -----------------------------------------
; Байт клетки стратегической карты, группа MapConst
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | OC | MR | ID | ID | ID | ID | ID | ID |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   OC       [7]      - флаг, занятость клетки объектом, маска Occupied=#80
;   MR       [6]      - флаг, горизонтальное отражение тайла, маска Mirror=#40
;   ID       [5..0]   - поле, индекс графического тайла, маска TileMask=#3F
; Проверено по потребителям:
;   Source/Engine/UpdateLocalView.asm, #8359/#835A/#835D/#835E/#8360
;   Source/Engine/FindMapObject.asm, #8D03/#8D06
; -----------------------------------------
TileMask        EQU 63                                                          ; маска графического ID клетки
Mirror          EQU 64                                                          ; горизонтальное отражение тайла
Occupied        EQU 128                                                         ; занятость клетки объектом
                endmodule
