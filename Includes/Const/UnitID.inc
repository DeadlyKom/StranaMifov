; идентификаторы типов совпадают с порядком исходных записей SOLDIERS
                module UnitID
None            EQU 0                                                           ; пустой отряд
Peasants        EQU 1                                                           ; Простолюдины
Soldiers        EQU 2                                                           ; Солдаты
Archers         EQU 3                                                           ; Лучники
Spearmen        EQU 4                                                           ; Копьеносцы
Cavalry         EQU 5                                                           ; Кавалеристы
Knights         EQU 6                                                           ; Рыцари
Nomads          EQU 7                                                           ; Кочевники
Celts           EQU 8                                                           ; Кельты
Vikings         EQU 9                                                           ; Викинги
Wolves          EQU 10                                                          ; Волки
Orcs            EQU 11                                                          ; Орки
Elves           EQU 12                                                          ; Эльфы
Ogres           EQU 13                                                          ; Людоеды
Trolls          EQU 14                                                          ; Тролли
Giants          EQU 15                                                          ; Гиганты
Dragons         EQU 16                                                          ; Драконы
Ghosts          EQU 17                                                          ; Призраки
Skeletons       EQU 18                                                          ; Скелеты
Zombies         EQU 19                                                          ; Зомби
Spectres        EQU 20                                                          ; Привидения
Vampires        EQU 21                                                          ; Вампиры
Dwarves         EQU 22                                                          ; Гномы
Druids          EQU 23                                                          ; Друиды
Warlocks        EQU 24                                                          ; Колдуны
Demons          EQU 25                                                          ; Демоны
                endmodule
