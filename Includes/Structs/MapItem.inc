; трёхбайтовая находка, не FTroop несмотря на одинаковую длину
                struct FMapItem

; -----------------------------------------
; FMapItem.Flags, смещение +#00
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | .. | .. | NO |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   NO       [0]      - флаг, 1 отмечает использованную или выключенную находку, 0 оставляет её
;     активной
; .. [7, 6, 5, 4, 3, 2, 1] - назначение не установлено
; Проверено по потребителям:
;   Source/Engine/StepMapTroops.asm, #93BF
;   Source/Engine/FindRecord.asm, #8DA3
; -----------------------------------------
Flags           DB #00                                                          ; бит 0 означает использованную/выключенную находку
X               DB #00                                                          ; столбец карты
Y               DB #00                                                          ; строка карты
                ends
                assert FMapItem = 3
