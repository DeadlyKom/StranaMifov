; рисунок и маска пиксельного курсора скрытого меню
; проверено по коду, Loader.Menu.DrawCursor, IX указывает в Pixels на очередную двухбайтовую строку и продвигается на2
                struct FMenuCursor
Pixels          DS 16, #00                                                      ; восемь двухбайтовых строк рисунка
Mask            DS 16, #00                                                      ; восемь двухбайтовых строк маски, единица сохраняет фон
                ends
                assert FMenuCursor = 32
