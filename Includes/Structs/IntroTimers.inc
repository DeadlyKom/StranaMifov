; интервал пиксельного сдвига и число сдвигов до следующей строки текста
; проверено по коду, TickIntroText
                struct FIntroTimers
Scroll          DB #00                                                          ; счётчик до очередного пиксельного сдвига вводного текста
Line            DB #00                                                          ; число сдвигов до выбора следующей строки вводного текста
                ends
                assert FIntroTimers = 2
