; цель случайного действия, 2 герой, 3 противник, бит 7 исключает уже проверенную цель полёта
; проверено по коду, ListOtherUnits, RandomTarget, RunUncontrolled
                struct FBattleTarget

; -----------------------------------------
; FBattleTarget.Side, смещение +#00
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | TX | SD | SD | SD | SD | SD | SD | SD |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   TX       [7] - флаг, 1 эта цель уже проверена и исключена из очередных попыток
;     полёта
;   SD       [6..0] - поле, 2 отряд героя, 3 отряд противника
; Проверено по потребителям:
;   Battle.ListOtherUnits
;   Battle.RandomTarget
;   Battle.RunUncontrolled
; -----------------------------------------
Side            DB #00                                                          ; 2 армия героя, 3 армия противника, бит 7 исключает уже проверенную цель полёта
Unit            FWord                                                           ; указатель боевого отряда
                ends
                assert FBattleTarget = 3
