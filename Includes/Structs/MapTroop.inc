; шестибайтовая группа существ на стратегической карте
                struct FMapTroop

; -----------------------------------------
; FMapTroop.Flags, смещение +#00
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | FC | WA | .. | .. | .. | .. | FR |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   FC       [6]      - флаг, горизонтальная ориентация, изменяется общей процедурой SetFacing
;   WA       [5]      - флаг, 1 соответствует водному режиму группы, 0 наземному
;   FR       [0]      - флаг, 1 означает свободную или использованную запись, 0 допускает
;     обработку
; .. [7, 4, 3, 2, 1] - назначение не установлено
; Проверено по потребителям:
;   Source/Engine/StepMapTroops.asm, #931A/#932D/#9330/#9336/#9425
;   Source/Engine/SetFacing.asm, #91C7/#91CC
; -----------------------------------------
Flags           DB #00                                                          ; состояние шестибайтовой группы, бит 0 свободна/использована, бит 5 вода, бит 6 ориентация, другие биты отдельно не именуются
X               DB #00                                                          ; столбец карты
Y               DB #00                                                          ; строка карты
ID              DB #00                                                          ; тип отряда, описатель SOLDIERS
Count           FWord                                                           ; беззнаковая численность little-endian
                ends
                assert FMapTroop = 6
