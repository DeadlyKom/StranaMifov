; область выбора скрытого меню
; проверено по коду, Loader.Menu.HighlightAreas и PollMenu
                struct FMenuArea

; -----------------------------------------
; FMenuArea.XAndActive, смещение +#00
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | AC | X  | X  | X  | X  | X  | X  | X  |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   AC       [7] - флаг, 1 область подсвечена обменом INK и PAPER, 0 подсветка снята
;   X        [6..0] - поле, столбец начала области в знакоместах
; Значение #FF целиком завершает список и проверяется раньше флага AC
; Проверено по потребителям:
;   Loader.Menu.HighlightAreas
;   Loader.Menu.PollMenu
; -----------------------------------------
XAndActive      DB #00                                                          ; столбец в битах 0..6, бит 7 хранит текущую подсветку, #FF завершает таблицу
Y               DB #00                                                          ; строка области
Width           DB #00                                                          ; ширина полосы атрибутов
                ends
                assert FMenuArea = 3
