; 35-байтная запись замка
                struct FCastle

; -----------------------------------------
; FCastle.Flags, смещение +#00
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | .. | .. | NO |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   NO       [0]      - флаг, 1 выключает запись замка из обхода, 0 оставляет её активной
; .. [7, 6, 5, 4, 3, 2, 1] - назначение не установлено
; Проверено по потребителям:
;   Source/Engine/CountOwnCastles.asm, #87B4/#87B8
; -----------------------------------------
Flags           DB #00                                                          ; бит 0 выключает запись, значения остальных битов отдельно не установлены
X               DB #00                                                          ; столбец карты
Y               DB #00                                                          ; строка карты
Name            DS 15, #00                                                      ; 15 символов имени CP866, допускается редактирование всех 15
Terminator      DB #00                                                          ; нулевой терминатор после имени
Owner           DB #00                                                          ; 0 собственный замок, 1..15 правитель FRuler, #FF особое отсутствие правителя/банды
Army            FTroopA5                                                        ; пять записей гарнизона FTroop
                ends
                assert FCastle = 35
