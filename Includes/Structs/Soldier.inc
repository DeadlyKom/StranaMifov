; описатель типа существа, SOLDIERS, 25 записей
                struct FSoldier
Name            DS 12, #00                                                      ; имя CP866, дополненное пробелами
NameEnd         DB #00                                                          ; нулевой терминатор имени

; -----------------------------------------
; FSoldier.MoveFlags, смещение +#0D
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | DR | WA | CL | CL | CL | FL | SH | MA |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   DR       [7]      - флаг, разрешает атакующему увеличивать численность за счёт нанесённого
;     урона
;   WA       [6]      - флаг, при корабельном событии 1 защищает от отметки утонувшего отряда, 0
;     ставит её в ID
;   CL       [5..3]   - часть маски, биты маски совместимости с классом местности, отдельные
;     игровые имена классов не установлены
;   FL       [2]      - флаг, способность полёта, для взлёта героя требуется у всех отрядов
;   SH       [1]      - флаг, обычная дальняя атака, при сброшенном MA не используется ветвь
;     магического действия
;   MA       [0]      - флаг, магическое дальнее действие, включает проверку магической защиты
;     цели
; Младшие три бита копируются в боевую запись, режим построения 3 дополнительно снимает SH и FL
; Проверено по потребителям:
;   Source/Battle/InputLoop.asm, #D5C2/#D5CE/#D520/#DAFE
;   Source/Overlays/TakeOff.asm, #B217/#B21C
;   Source/Engine/StepMapTroops.asm, #93F2/#93F9
;   Source/Engine/FilterArmy.asm, #8C5A/#8C5E
;   Source/Engine/TickTime.asm, #9A12/#9A15/#9A17/#9A19
;   Source/Battle/ApplyDrainTrait.asm, #F2FA/#F302/#F30B
; -----------------------------------------
MoveFlags       DB #00                                                          ; первый байт способностей, младшие 3 бита копируются в боевые флаги

; -----------------------------------------
; FSoldier.ExtraFlags, смещение +#0E
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | CT | G5 | HV | MI | AT |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   CT       [4]      - флаг, допускает раннюю городскую ветвь даже при сброшенном бите 1 флагов
;     города
;   G5       [3]      - флаг, допускает цель для выбора ИИ заклинания 5, игрокова ветвь отдельно
;     этот бит не проверяет
;   HV       [2]      - флаг, особый удар, при случайном результате от #59 численность цели
;     делится на 2
;   MI       [1]      - флаг, цель не поддаётся целевому магическому воздействию, проверяется
;     также перед лечением и переносом
;   AT       [0]      - флаг, при финансовом событии 1 выбирает отметку атакующего отряда, 0
;     отметку сбежавшего
; .. [7, 6, 5] - назначение не установлено
; Проверено по потребителям:
;   Source/Engine/TickTime.asm, #9B0C/#9B0E/#9B10/#9B14/#9B67/#9B72
;   Source/Battle/InputLoop.asm, #D5CE/#D73A/#D7BC/#D8A6/#D925/#D967/#D9AA
;   Source/Battle/ResolveAttack.asm, #F0F5/#F119
;   Source/Battle/AISpell.asm, #EF11/#EF18/#EF3A
;   Source/Overlays/City.asm, #B21A/#B229/#B22C/#B22E/#B237
; -----------------------------------------
ExtraFlags      DB #00                                                          ; второй байт флагов, возвращаемый в D без назначения всех битов
Actions         DB #00                                                          ; исходное число действий на раунд
ActionStock     DB #00                                                          ; запас расходуемого дальнего действия
SectID          DB #00                                                          ; секта типа, 0 без поправки, 5 либо совпадение с сектой героя повышает совместимость
SpawnClass      DB #00                                                          ; категория 1..4 при выборе начального типа
UpgradeID       DB #00                                                          ; ID замены по служебному порогу участия
DegradeID       DB #00                                                          ; ID замены при утрате квалификации, 0 запрещает замену

; -----------------------------------------
; FSoldier.SpecialFlags, смещение +#15
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | EN | CR | ND | CP |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   EN       [3]      - флаг, поражение от армии с таким типом запускает ветвь сюжетного
;     окончания
;   CR       [2]      - флаг, позволяет отряду переносить героя в полёте, нужен хотя бы один
;     такой отряд
;   ND       [1]      - флаг, цель запрещает атакующему восстанавливать численность за счёт
;     нанесённого ей урона
;   CP       [0]      - флаг, при восстановлении численности ограничивает результат исходным
;     InitialCount
; .. [7, 6, 5, 4] - назначение не установлено
; Проверено по потребителям:
;   Source/Battle/ClampRegen.asm, #F33C/#F345/#F34B/#F360
;   Source/Battle/ApplyDrainTrait.asm, #F302/#F30B
;   Source/Overlays/TakeOff.asm, #B230/#B237
;   Source/Battle/DefeatStory.asm, #F8A8/#F8AB/#F8B3
; -----------------------------------------
SpecialFlags    DB #00                                                          ; особые способности, ограничение восстановления и участие в перевозке
UnitValue       FWord                                                           ; вес одного воина в оценке армии и цене найма корабля
Upkeep          FWord                                                           ; расходы на содержание одного воина
BattleValue     FWord                                                           ; вес одного воина в общей оценке армии при начале и завершении боя
Unknown1C       DS 4, #00                                                       ; четыре сохраняемых байта
SpawnCount      FWord                                                           ; начальная численность создаваемой шестибайтовой группы
DamageSpread    FWord                                                           ; слово разброса урона, удваивается только младший байт E без переноса в D
DamageDivisor   FWord                                                           ; делитель базовой формулы урона
SiteGrowthDiv   DB #00                                                          ; делитель недельного прироста в строениях и гарнизонах
ArmyGrowthDiv   DB #00                                                          ; делитель недельного прироста внешней армии и армии героя
UpgradeLimit    DB #00                                                          ; порог служебного счётчика для первой замены
DegradeDays     DB #00                                                          ; порог дней без боя, исходная ветвь требует также ненулевой DegradeID
                ends
                assert FSoldier = 42
