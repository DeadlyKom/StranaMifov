; статья недельного расхода
; проверено по коду, TickTime/SumExpenses обходят запись с шагом6, бит6 активен, бит7 выбран для оплаты, биты0..4 строка экрана, Float5 начинается+1
                struct FExpense

; -----------------------------------------
; FExpense.Flags, смещение +#00
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | PY | AC | .. | RW | RW | RW | RW | RW |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   PY       [7] - флаг, 1 статья выбрана для оплаты и включается в SumExpenses
;   AC       [6] - флаг, 1 статья существует и показана в текущем недельном расчёте
;   RW       [4..0] - поле, строка показа статьи и её прямоугольника выбора
; .. [5] - назначение не установлено
; До подтверждения выбора PY ещё не означает фактического списания денег
; Проверено по потребителям:
;   Engine.TickTime
;   Engine.SumExpenses
; -----------------------------------------
Flags           DB #00                                                          ; номер строки в битах 0..4, бит 6 активная статья, бит 7 статья выбрана для оплаты
Amount          FFloat5                                                         ; стоимость статьи в формате калькулятора
                ends
                assert FExpense = 6
