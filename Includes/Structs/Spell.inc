; описатель заклинания в DATA1
                struct FSpell
Name            DS 20, #00                                                      ; 20 символов названия заклинания, дополнение пробелами
Terminator      DB #00                                                          ; ноль после имени
ManaCost        FWord                                                           ; магическая стоимость, также служит основанием цены изучения с множителем 100 и модификатором секты
                ends
                assert FSpell = 23
