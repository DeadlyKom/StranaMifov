; рабочий кандидат перемещения внешнего объекта
                struct FMoveStep
TerrainMask     DB #00                                                          ; маска класса местности кандидата, #FF выделяет водный класс, 0 не требует проверки способностей
X               DB #00                                                          ; столбец соседней клетки
Y               DB #00                                                          ; строка соседней клетки
                ends
                assert FMoveStep = 3
