; заголовок RLE-изображения HERIMG, BL1 и BL2
                struct FPictureHeader
NextOffset      FWord                                                           ; следующий заголовок равен текущий адрес +1+NextOffset
FirstThird      DB #00                                                          ; начальная треть экрана 0..2
ThirdCount      DB #00                                                          ; число третей 1..3

; -----------------------------------------
; FPictureHeader.Flags, смещение +#04
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | AT | RN | .. | RO |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   AT       [3]      - флаг, в рабочей копии распаковщика идёт линейный вывод атрибутов вместо
;     пиксельных циклов
;   RN       [2]      - флаг, в рабочей копии распаковщика продолжается RLE-серия, B' содержит
;     остаток, C' значение
;   RO       [0]      - флаг, порядок обхода пикселей, 1 внутренними сериями по 32 байта, 0 по
;     одному байту с вертикальным шагом
; .. [7, 6, 5, 4, 1] - назначение не установлено
; Флаги заголовка копируются в начало распаковщика +5, рабочие RN и AT изменяются во время
; вывода
; Алгоритм одинаков у HERIMG, BL1 и BL2, указанные адреса относятся к BL1 с базой #C000
; Проверено по потребителям:
;   Source/Files/33_BL1.asm, #C080/#C086/#C095/#C09B/#C0E4/#C0F3/#C106/#C0CD/#C10B/#C10F
; -----------------------------------------
Flags           DB #00                                                          ; бит 0 задаёт порядок обхода пикселей, биты 2/3 рабочие
                ends
                assert FPictureHeader = 5
