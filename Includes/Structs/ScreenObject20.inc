; FScreenObject20
                struct FScreenObject20

; -----------------------------------------
; FScreenObject20.Flags, смещение +#00
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | BM | FM | NU | MD | MD | MD | MD | MD |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   BM       [7]      - флаг, горизонтально отражать основное изображение в режимах 1, 2, 3 и 4
;   FM       [6]      - флаг, горизонтально отражать передний маскированный слой в режимах 3 и 4
;   NU       [5]      - флаг, после выполненного вывода подписать число из массива #6931 +
;     2*индекс объекта
;   MD       [4..0]   - поле, режим 0 без вывода, 1 фон с атрибутами, 2 маска, 3 фон и маска, 4
;     фон и кадры
; После режимов 1..3 младшие пять битов очищаются, режим 4 сохраняется между тиками
; Проверено по потребителям:
;   Source/Engine/RenderObjects.asm, #8118/#811D/#8140/#8163/#819A/#81F4/#8214/#821C/#818A/#81E7/#812A/#814D/#8170/#81C5
; -----------------------------------------
Flags           DB #00                                                          ; младшие 5 бит режим 0..4, бит 5 численная подпись, биты 6/7 отражение
AnimationTimer  DB #00                                                          ; счётчик до следующего кадра, DEC, при 0 перезагрузка из+3
AnimationFrame  DB #00                                                          ; текущий номер кадра 1..FrameCount, увеличивается перед выводом
AnimationPeriod DB #00                                                          ; значение перезагрузки счётчика
FrameCount      DB #00                                                          ; число кадров, #7366 задаёт 4
BaseBank        DB #00                                                          ; банк основного изображения
BaseAddress     FWord                                                           ; младший байт адреса первым
Frame1Bank      DB #00                                                          ; банк переднего слоя либо первого кадра
Frame1Address   FWord                                                           ; адрес переднего слоя либо первого кадра
Frame2Bank      DB #00                                                          ; банк второго кадра
Frame2Address   FWord                                                           ; адрес второго кадра
Frame3Bank      DB #00                                                          ; банк третьего кадра
Frame3Address   FWord                                                           ; адрес третьего кадра
Frame4Bank      DB #00                                                          ; банк четвёртого кадра
Frame4Address   FWord                                                           ; адрес четвёртого кадра
                ends
                assert FScreenObject20 = 20
