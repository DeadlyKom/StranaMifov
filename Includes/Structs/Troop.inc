; исходная стратегическая запись отряда
                struct FTroop

; -----------------------------------------
; FTroop.ID, смещение +#00, обычный ID и временные отметки TickTime
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | AT | RU | DW | ID | ID | ID | ID | ID |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   AT       [7]      - флаг, временная отметка атакующего отряда, также ставится при совпадении
;     секты
;   RU       [6]      - флаг, временная отметка сбежавшего отряда в финансовой ветви
;   DW       [5]      - флаг, временная отметка утонувшего отряда в корабельном событии
;   ID       [4..0]   - поле, ID типа существа 1..25, 0 завершает плотный список
; Вне указанных промежуточных ветвей поле остаётся обычным идентификатором
; Это не набор постоянных свойств типа, постоянные способности лежат в FSoldier
; Проверено по потребителям:
;   Source/Engine/TickTime.asm, #9B07/#9B4B/#9A15/#9A17/#9A19/#9B5C/#9B0C/#9B0E/#9B14/#9B72/#9AA1/#9AA6/#9B10/#9B67
; -----------------------------------------
ID              DB #00                                                          ; ID типа отряда, 0 завершает плотный список. В финансовом проходе #9B10/#9B14 временно устанавливаются биты 7/6, поэтому не во всех промежуточных состояниях байт является чистым ID
Count           FWord                                                           ; беззнаковая численность little-endian
                ends
                assert FTroop = 3
