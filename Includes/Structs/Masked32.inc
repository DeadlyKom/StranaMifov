; маскированный кадр 32 на 32 пикселя
                struct FMasked32
Pixels          DS 128, #00                                                     ; передний слой INK, 32 строки по 4 байта
Mask            DS 128, #00                                                     ; маска, единица сохраняет соответствующий бит фона
                ends
                assert FMasked32 = 256
