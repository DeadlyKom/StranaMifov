; рабочий отряд боя, две армии по 5 записей
                struct FBattleUnit
UnitID          DB #00                                                          ; ID типа, 0 завершает плотный список
Affinity        DB #00                                                          ; знаковая совместимость состава от -2 до 2, для выбора поправки прибавляется 3
Quantity        DS 5, #00                                                       ; пятибайтовое число ROM, сохраняет дробные потери
BaseActions     DB #00                                                          ; число действий в начале раунда
ActionStock     DB #00                                                          ; остаток расходуемого дальнего действия

; -----------------------------------------
; FBattleUnit.Flags, смещение +#09
; представление армии героя
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | OC | TX | TC | HR | HA | FL | SH | MA |
;   +----+----+----+----+----+----+----+----+
;
;   флаги:
;   OC       [7] - флаг, численность отряда превышает предел управления героя
;     UNIT_UNRULE_BIT
;   TX       [6] - флаг, временно исключить отряд из повторного выбора цели
;     UNIT_SKIP_BIT
;   TC       [5] - флаг, временная отметка соседства или кандидата в текущем проходе выбора цели
;     UNIT_MARK_BIT
;   HR       [4] - флаг, отряд героя достижим для проверяемого отряда ИИ
;     HERO_REACH_BIT
;   HA       [3] - флаг, отряд героя уже выбирался в текущем круге выбора действующего отряда
;     HERO_ACTED_BIT
;   FL       [2] - флаг, способность к полёту, доступность действия дополнительно зависит от
;     эффекта
;     UNIT_FLY_BIT
;   SH       [1] - флаг, тип отряда использует обычную дальнюю атаку
;     UNIT_SHOT_BIT
;   MA       [0] - флаг, тип отряда использует магическое дальнее действие
;     UNIT_MAGIC_BIT
; представление армии ИИ
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | TX | TC | DN | DF | FL | SH | MA |
;   +----+----+----+----+----+----+----+----+
;
;   флаги:
;   TX       [6] - флаг, временно исключить отряд из повторного выбора цели
;     UNIT_SKIP_BIT
;   TC       [5] - флаг, временная отметка соседства или кандидата в текущем проходе выбора цели
;     UNIT_MARK_BIT
;   DN       [4] - флаг, обработка отряда ИИ в текущем раунде завершена
;     AI_DONE_BIT
;   DF       [3] - флаг, действие отряда ИИ отложено до повторного прохода армии с режимом 3
;     AI_DEFERRED_BIT
;   FL       [2] - флаг, способность к полёту, доступность действия дополнительно зависит от
;     эффекта
;     UNIT_FLY_BIT
;   SH       [1] - флаг, тип отряда использует обычную дальнюю атаку
;     UNIT_SHOT_BIT
;   MA       [0] - флаг, тип отряда использует магическое дальнее действие
;     UNIT_MAGIC_BIT
; Бит 7 у армии ИИ здесь не получает самостоятельного назначения
; ResetTurnFlags сохраняет способности 2..0 и очищает временные отметки 7..3
; -----------------------------------------
Flags           DB #00                                                          ; способности и временные отметки раунда, цели и контроля
X               DB #00                                                          ; колонка 0..7
Y               DB #00                                                          ; строка 0..4
ActionsLeft     DB #00                                                          ; оставшиеся действия текущего раунда

; -----------------------------------------
; FBattleUnit.Effect, смещение +#0D, два числовых поля
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | EF | EF | EF | EF | TM | TM | TM | TM |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   EF       [7..4]   - поле, номер действующего эффекта, извлекается четырьмя SRL
;   TM       [3..0]   - поле, оставшаяся длительность, уменьшается в конце раунда, при 1
;     очищается весь байт
; EF и TM являются числами из четырёх битов, не независимыми флагами
; Проверено по потребителям:
;   Source/Battle/EffectFactor.asm, #F2D6/#F2DC
;   Source/Battle/TickEffects.asm, #F5F7/#F60D
; -----------------------------------------
Effect          DB #00                                                          ; старшая тетрада вид эффекта, младшая оставшаяся длительность
InitialCount    FWord                                                           ; исходное целое количество, ограничивает восстановление
Unknown10       FWord                                                           ; два сохраняемых служебных байта
                ends
                assert FBattleUnit = 18
