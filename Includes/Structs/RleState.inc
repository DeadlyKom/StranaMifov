; рабочие настройки самоперемещаемого распаковщика изображений
; проверено по коду, Graphics.Heroes/Graphics.BL1/Graphics.BL2 Draw и Unpack
                struct FRleState
Picture         DB #00                                                          ; номер изображения от1
FirstThird      DB #00                                                          ; начальная треть экрана0..2, #FF брать значение из заголовка
ThirdCount      DB #00                                                          ; число третей экрана1..3, #FF брать значение из заголовка

; -----------------------------------------
; FRleState.Flags, смещение +#03
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | AT | RN | .. | HR |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   AT       [3] - флаг, 1 декодирует линейные атрибуты, 0 пиксели с нелинейным экранным
;     шагом
;   RN       [2] - флаг, 1 продолжает ранее начатую RLE-серию из альтернативных B и C
;   HR       [0] - флаг, 1 поток идёт горизонтальными строками, 0 вертикальными блоками
; .. [7, 6, 5, 4, 1] - назначение не установлено
; RN меняется внутри распаковщика, AT устанавливается после завершения пикселей
; Проверено по потребителям:
;   Graphics.Heroes.Unpack
;   Graphics.Scenes1.Unpack
;   Graphics.Scenes2.Unpack
; -----------------------------------------
Flags           DB #00                                                          ; бит0 порядок потока, бит2 активная RLE серия, бит3 вывод линейных атрибутов
                ends
                assert FRleState = 4
