; персональная часть состояния, имя и игровые поля. Совпадает с245байтными PERSON1..6/8 после загрузки
                struct FPerson
Name            DS 9, #00                                                       ; имя выбранного героя, девять символов CP866
Terminator      DB #00                                                          ; нулевой терминатор имени
Leadership      FWord                                                           ; лидерство, задаёт предел количества отряда через деление на коэффициент типа
Mana            FWord                                                           ; текущая магическая сила героя
ManaMax         FWord                                                           ; максимум магической силы
ManaRegen       FWord                                                           ; пополнение магической силы при очередном восстановлении

; -----------------------------------------
; FPerson.Spells, каждый из 10 байтов, смещение +#12
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | .. | .. | KN |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   KN       [0]      - флаг, заклинание изучено, 1 позволяет вывести его в списке известных
;     заклинаний
; .. [7, 6, 5, 4, 3, 2, 1] - назначение не установлено
; Проверено по потребителям:
;   Source/Overlays/Info.asm, #B922/#B925/#B926
; -----------------------------------------
Spells          DS 10, #00                                                      ; 10 байтов состояния заклинаний, бит 0 — заклинание изучено, остальные биты отдельно не именуются
Money           FFloat5                                                         ; наличные монеты в пятибайтном формате калькулятора ROM
BaseIncome      FFloat5                                                         ; постоянная часть недельного дохода в формате Float5, складывается с доходами замков
Army            FTroopA5                                                        ; пять записей армии героя FTroop
Continent       DB #00                                                          ; текущий континент 1..4
X               DB #00                                                          ; столбец текущей клетки героя
Y               DB #00                                                          ; строка текущей клетки героя
ShipMap         DB #00                                                          ; континент корабля, #FF означает отсутствие корабля
ShipX           DB #00                                                          ; столбец корабля, #FF является признаком отсутствия
ShipY           DB #00                                                          ; строка корабля

; -----------------------------------------
; FPerson.MoveFlags, смещение +#3B, адрес #6A33
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | SG | SF | HF | NH | MD | MD |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   SG       [5]      - флаг, наличие осадного орудия, перед полётом предлагается его оставить
;   SF       [4]      - флаг, ориентация корабля, 1 задаётся при шаге вправо на корабле, 0 при
;     шаге влево
;   HF       [3]      - флаг, ориентация героя, 1 задаётся при шаге вправо, 0 при шаге влево
;   NH       [2]      - флаг, 1 пропускает подготовку изображения героя в локальном окне
;   MD       [1..0]   - поле, режим движения, 0 суша, 1 корабль, 2 полёт
; .. [7, 6] - назначение не установлено
; Значение режима 3 отдельным способом движения не объявляется
; Проверено по потребителям:
;   Source/Engine/UpdateLocalView.asm, #846E/#8470/#8477/#843E/#8440/#8453/#8457/#84A6/#84AA
;   Source/Overlays/TakeOff.asm, #B27A/#B23C/#B27C
;   Source/Overlays/Land.asm, #B200
;   Source/Engine/TickCastle.asm, #A837/#A842
;   Source/Engine/MapMoveRight.asm, #8C1E/#8C25/#8C2B
;   Source/Engine/MapMoveLeft.asm, #8C02/#8C09/#8C0F
;   Source/Overlays/Info.asm, #B336
; -----------------------------------------
MoveFlags       DB #00                                                          ; младшие 2 бита — режим 0 суша/1 корабль/2 полёт, бит 2 служебный режим вида, биты 3/4 ориентация героя/корабля, бит 5 наличие осадных орудий. Биты 6/7 здесь не установлены

; -----------------------------------------
; FPerson.MapFlags, смещение +#3C, адрес #6A34
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | M4 | M3 | M2 | M1 | .. | C4 | C3 | C2 |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   M4       [7]      - флаг, доступна полная карта континента 4
;   M3       [6]      - флаг, доступна полная карта континента 3
;   M2       [5]      - флаг, доступна полная карта континента 2
;   M1       [4]      - флаг, доступна полная карта континента 1
;   C4       [2]      - флаг, разрешён выбор континента 4 в морском меню
;   C3       [1]      - флаг, разрешён выбор континента 3 в морском меню
;   C2       [0]      - флаг, разрешён выбор континента 2 в морском меню, этот же бит разрешает
;     вход в меню перехода
; .. [3] - назначение не установлено
; Континент 1 добавляется морским меню независимо от флага, число пунктов строится по маске #0F
; Оверлей 13 модифицирует номер бита инструкции BIT по формуле Continent + 3
; Проверено по потребителям:
;   Source/Overlays/Sail.asm, #B203/#B205/#B232/#B235/#B237/#B239/#B245
;   Source/Overlays/Maps.asm, #B271/#B275/#B278/#B282/#B285
; -----------------------------------------
MapFlags        DB #00                                                          ; флаги доступных полных карт/континентов, биты выбираются по континенту
DayFraction     DB #00                                                          ; дробная часть дня в единицах 1/256, переполнение увеличивает Days
Days            FWord                                                           ; счётчик прошедших дней
Deadline        FWord                                                           ; предел числа дней, поражение вызывается именно при Days == Deadline
Contract        DB #00                                                          ; номер замка текущего контракта с 1, 0 означает отсутствие
Cult            DB #00                                                          ; принадлежность героя к секте, 0 не состоит
Unknown6A3C     DS 8, #00                                                       ; содержимое восьми байтов не получило подтверждённых игровых имён
GoodX           DB #00                                                          ; столбец соответствующего рассказчика
GoodY           DB #00                                                          ; строка соответствующего рассказчика
GoodMap         DB #00                                                          ; континент соответствующего рассказчика
Unknown6A47     FWord                                                           ; два байта между континентом и счётчиком встреч, назначение не установлено
GoodVisits      FWord                                                           ; число встреч с соответствующим рассказчиком
BadX            DB #00                                                          ; столбец соответствующего рассказчика
BadY            DB #00                                                          ; строка соответствующего рассказчика
BadMap          DB #00                                                          ; континент соответствующего рассказчика
Unknown6A4E     FWord                                                           ; два байта между континентом и счётчиком встреч, назначение не установлено
BadVisits       FWord                                                           ; число встреч с соответствующим рассказчиком
Unknown6A52     DS 3, #00                                                       ; назначение трёх байтов не установлено

; -----------------------------------------
; FPerson.PuzzleOpen, каждый из 5 байтов строки, смещение +#5D
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | P0 | P1 | P2 | P3 | P4 |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   P0       [4]      - флаг, открыт фрагмент текущей строки в столбце 0, столбцы считаются
;     слева с 0
;   P1       [3]      - флаг, открыт фрагмент текущей строки в столбце 1, столбцы считаются
;     слева с 0
;   P2       [2]      - флаг, открыт фрагмент текущей строки в столбце 2, столбцы считаются
;     слева с 0
;   P3       [1]      - флаг, открыт фрагмент текущей строки в столбце 3, столбцы считаются
;     слева с 0
;   P4       [0]      - флаг, открыт фрагмент текущей строки в столбце 4, столбцы считаются
;     слева с 0
; .. [7, 6, 5] - назначение не установлено
; Пять младших битов соответствуют пяти фрагментам строки, старшие три потребитель отбрасывает
; Проверено по потребителям:
;   Source/Overlays/TargetMap.asm, #B25B/#B25E/#B260/#B262/#B268
;   Source/Overlays/Capture.asm, #B5C1/#B5C5
; -----------------------------------------
PuzzleOpen      DS 5, #00                                                       ; пять строк по 5 бит открытых частей карты цели
PuzzleTiles     DS 25, #00                                                      ; образец квадратного участка 5x5 для поиска посоха, сравнение младших 6 бит
IdleDays        DS 25, #00                                                      ; 25 счётчиков дней по ID1..25, сброс при добавлении нового ID, используется порогом деградации
UpgradeCount    DS 25, #00                                                      ; 25 счётчиков развития по ID1..25, сравниваются с SOLDIERS+40, точная единица накопления в данном файле не устанавливается
Unknown6AA5     DB #00                                                          ; назначение байта не установлено
Wins            FWord                                                           ; счётчик побед, ResolveLosses увеличивает только младший байт, город читает слово
Losses          FWord                                                           ; счётчик поражений, ResolveLosses увеличивает только младший байт, город читает слово
Attacker        DB #00                                                          ; 0 нет угрозы замку, 1..15 правитель, #FF банды
AttackDays      DB #00                                                          ; дни до разрешения угрозы, исходно 20+R(15)
AttackCastle    FWord                                                           ; адрес физической 35 байтной записи атакуемого замка в банке 0
AttackArmy      FTroopA5                                                        ; пять записей FTroop атакующей армии, построение создаёт 2..4 отряда
Unknown6ABD     DS 23, #00                                                      ; 23 сохраняемых байта до массива коэффициентов контроля, назначение не установлено
UnitControl     DS 25, #00                                                      ; 25 коэффициентов предела контроля армии по ID1..25, предел=floor(Leadership/коэффициент)
                ends
                assert FPerson = 245
