; трёхбайтовый шаг музыкального семпла
; проверено по коду, Music.Menu.ReadSampleStep
                struct FSampleStep

; -----------------------------------------
; FSampleStep.ToneAndVolume, смещение +#00
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | TH | TH | TH | TH | VL | VL | VL | VL |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   TH       [7..4] - поле, старшая тетрада величины смещения периода тона
;   VL       [3..0] - поле, громкость канала 0..15
; Младший байт смещения хранится отдельно в FSampleStep.ToneLow
; Проверено по потребителям:
;   Music.Menu.ReadSampleStep
; -----------------------------------------
ToneAndVolume   DB #00                                                          ; старшие четыре бита величины смещения тона и младшие четыре бита громкости

; -----------------------------------------
; FSampleStep.NoiseAndFlags, смещение +#01
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | ND | TD | PL | NS | NS | NS | NS | NS |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   ND       [7] - флаг, 1 отключает шум канала
;   TD       [6] - флаг, 1 отключает тон канала
;   PL       [5] - флаг, 1 прибавляет смещение к периоду ноты, 0 вычитает его
;   NS       [4..0] - поле, период шума AY 0..31
; Проверено по потребителям:
;   Music.Menu.ReadSampleStep
;   Music.Menu.CalcTonePeriod
; -----------------------------------------
NoiseAndFlags   DB #00                                                          ; период шума0..31, бит5 знак смещения, бит6 запрет тона, бит7 запрет шума
ToneLow         DB #00                                                          ; младший байт смещения периода тона
                ends
                assert FSampleStep = 3
