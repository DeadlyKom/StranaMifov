; общая координатная часть разных объектов карты
; проверено по коду, Overlay.Maps.MarkSiteList получает шаг записи от вызывающего кода, читает лишь первые3поля
                struct FMapSite

; -----------------------------------------
; FMapSite.Flags, смещение +#00
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | .. | .. | NO |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   NO       [0] - флаг, 1 запись выключена из общего обхода карты
; .. [7, 6, 5, 4, 3, 2, 1] - назначение не установлено
; Это общий префикс разных записей, остальные биты зависят от конкретного типа
; Проверено по потребителям:
;   Overlay.Maps.MarkSiteList
; -----------------------------------------
Flags           DB #00                                                          ; бит0 выключает запись
X               DB #00                                                          ; столбец стратегической карты
Y               DB #00                                                          ; строка стратегической карты
                ends
                assert FMapSite = 3
