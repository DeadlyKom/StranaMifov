; 26-байтная запись города
                struct FTown

; -----------------------------------------
; FTown.Flags, смещение +#00
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | .. | CB | NO |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   CB       [1]      - флаг, 1 разрешает раннюю городскую ветвь, но вызывает отказ при запросе
;     нового контракта
;   NO       [0]      - флаг, 1 выключает запись города из общего поиска, 0 оставляет её
;     активной
; .. [7, 6, 5, 4, 3, 2] - назначение не установлено
; Нулевой CB сам по себе не гарантирует новый контракт, далее есть другие проверки
; Проверено по потребителям:
;   Source/Engine/FindMapObject.asm, #8D41/#8D49
;   Source/Engine/FindRecord.asm, #8DA3
;   Source/Overlays/City.asm, #B21A/#B21E/#B4EB/#B4EF/#B4F1
; -----------------------------------------
Flags           DB #00                                                          ; бит 0 выключает запись, бит 1 проверяется при доступности контракта
X               DB #00                                                          ; столбец карты
Y               DB #00                                                          ; строка карты
Name            DS 11, #00                                                      ; 11 символов имени CP866
Terminator      DB #00                                                          ; нулевой терминатор имени
DockPos         FWord                                                           ; координаты причала, Low столбец и High строка, нулевое слово означает отсутствие причала
Army            FTroopA3                                                        ; до трёх отрядов FTroop
                ends
                assert FTown = 26
