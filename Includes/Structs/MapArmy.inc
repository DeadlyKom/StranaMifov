; подвижная армия разбойников либо пиратов
                struct FMapArmy

; -----------------------------------------
; FMapArmy.Flags, смещение +#00
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | FC | WA | PR | DL | DL | DL | FR |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   FC       [6]      - флаг, горизонтальная ориентация, направления 2..4 ставят бит, 6..8
;     снимают, 1 и 5 сохраняют
;   WA       [5]      - флаг, 1 выбирает водный класс группы пиратов, 0 наземный класс
;     разбойников
;   PR       [4]      - флаг, запись уже обработана в текущем проходе, в конце обхода отметка
;     снимается
;   DL       [3..1]   - поле, задержка 0..7, ненулевое значение уменьшается на 1 и пропускает
;     движение
;   FR       [0]      - флаг, 1 означает свободную или выключенную запись, 0 допускает обработку
; .. [7] - назначение не установлено
; Проверено по потребителям:
;   Source/Engine/StepArmies.asm, #8E3B/#8F69/#8E43/#8E47/#8E4D/#9150/#9169/#8E6B
;   Source/Overlays/Bandits.asm, #B22A
;   Source/Engine/SetFacing.asm, #91BF/#91C2/#91C7/#91CC
; -----------------------------------------
Flags           DB #00                                                          ; состояние внешней армии
X               DB #00                                                          ; столбец стратегической карты
Y               DB #00                                                          ; строка стратегической карты
Mana            FWord                                                           ; текущий запас магической силы внешней армии. Восстанавливается с пределом 15000 и передаётся словом DE в бой
ManaRegen       FWord                                                           ; прибавляемое при регенерации количество магической силы
Army            FTroopA5                                                        ; пять стратегических отрядов FTroop
                ends
                assert FMapArmy = 22
