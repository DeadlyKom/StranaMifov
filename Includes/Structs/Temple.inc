; запись храма духов
                struct FTemple

; -----------------------------------------
; FTemple.Flags, смещение +#00
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | .. | .. | NO |
;   +----+----+----+----+----+----+----+----+
;
;   флаги и поля:
;   NO       [0]      - флаг, 1 выключает запись храма из общего поиска, 0 оставляет её активной
; .. [7, 6, 5, 4, 3, 2, 1] - назначение не установлено
; Дескриптор типа 3 в FindMapObject задаёт шаг 5 байтов для записей храма
; Проверено по потребителям:
;   Source/Engine/FindMapObject.asm, #8D49
;   Source/Engine/FindRecord.asm, #8DA3
; -----------------------------------------
Flags           DB #00                                                          ; бит 0 выключает запись
X               DB #00                                                          ; столбец карты
Y               DB #00                                                          ; строка карты
Cult            DB #00                                                          ; тип храма/секты
Spell           DB #00                                                          ; ID доступного для изучения заклинания
                ends
                assert FTemple = 5
